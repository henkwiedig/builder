+struct sc231ai {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct device *dev;
+
+	/* Where the sensor actually answers: the core's client, or an
+	 * ancillary one when the node is shared with the NT99235.
+	 */
+	struct i2c_client *i2c;
+
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *enable_gpio;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *again;
+};
+
+/*
+ * Live exposure and gain as writable module parameters, with the same names
+ * and units as the NT99235 driver's, so the AE loop drives either sensor by
+ * writing /sys/module/<sensor>/parameters/{exposure,gain}. The V4L2 controls
+ * mirror them.
+ */
+static struct sc231ai *sc231ai_bound;
+static DEFINE_MUTEX(sc231ai_bound_lock);
+
+static int exposure = SC231AI_EXPOSURE_MAX;
+static int gain = SC231AI_GAIN_CODE_DEFAULT;
+
+static int orientation;
+
+static bool test_pattern;
+module_param(test_pattern, bool, 0644);
+MODULE_PARM_DESC(test_pattern,
+		 "sensor test pattern (a neutral ramp) instead of the image, applied at stream-on (default off)");
+
+static inline struct sc231ai *to_sc231ai(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc231ai, sd);
+}
+
+static int sc231ai_write(struct sc231ai *sc, u16 address, u8 value)
+{
+	u8 buf[3] = { address >> 8, address & 0xff, value };
+	int ret = i2c_master_send(sc->i2c, buf, sizeof(buf));
+
+	if (ret != sizeof(buf)) {
+		dev_err(sc->dev, "write 0x%04x = 0x%02x failed (%d)\n",
+			address, value, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	return 0;
+}
+
+static int sc231ai_read(struct sc231ai *sc, u16 address, u8 *value)
+{
+	u8 addr_buf[2] = { address >> 8, address & 0xff };
+	struct i2c_msg msgs[2] = {
+		{
+			.addr = sc->i2c->addr,
+			.len = sizeof(addr_buf),
+			.buf = addr_buf,
+		},
+		{
+			.addr = sc->i2c->addr,
+			.flags = I2C_M_RD,
+			.len = 1,
+			.buf = value,
+		},
+	};
+	int ret = i2c_transfer(sc->i2c->adapter, msgs, ARRAY_SIZE(msgs));
+
+	if (ret != ARRAY_SIZE(msgs))
+		return ret < 0 ? ret : -EIO;
+
+	return 0;
+}
+
+static int sc231ai_write_regs(struct sc231ai *sc,
+			      const struct sc231ai_reg *regs, unsigned int n)
+{
+	for (unsigned int i = 0; i < n; i++) {
+		int ret = sc231ai_write(sc, regs[i].address, regs[i].value);
+
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * The vendor power-on (sc231ai_cmos_power_on): both lines low, the 24 MHz
+ * master clock on, reset released, 10 ms. The enable line stays asserted for
+ * the session; power-off asserts reset and stops the clock.
+ */
+static int sc231ai_power_on(struct device *dev)
+{
+	struct sc231ai *sc = to_sc231ai(dev_get_drvdata(dev));
+	int ret;
+
+	gpiod_direction_output(sc->enable_gpio, 1);
+	gpiod_direction_output(sc->reset_gpio, 1);
+	usleep_range(SC231AI_RESET_SETTLE_US, SC231AI_RESET_SETTLE_US + 1000);
+
+	ret = clk_prepare_enable(sc->mclk);
+	if (ret) {
+		dev_err(dev, "failed to enable the master clock (%d)\n", ret);
+		return ret;
+	}
+
+	gpiod_set_value_cansleep(sc->reset_gpio, 0);
+	usleep_range(SC231AI_RESET_SETTLE_US, SC231AI_RESET_SETTLE_US + 1000);
+
+	return 0;
+}
+
+static int sc231ai_power_off(struct device *dev)
+{
+	struct sc231ai *sc = to_sc231ai(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc->reset_gpio, 1);
+	clk_disable_unprepare(sc->mclk);
+
+	return 0;
+}
+
+static int sc231ai_detect(struct sc231ai *sc)
+{
+	u8 hi, lo;
+
+	if (sc231ai_read(sc, SC231AI_REG_CHIP_ID_HI, &hi) ||
+	    sc231ai_read(sc, SC231AI_REG_CHIP_ID_LO, &lo))
+		return -ENODEV;
+
+	if (((hi << 8) | lo) != SC231AI_CHIP_ID) {
+		dev_info(sc->dev, "chip id 0x%02x%02x at 0x%02x is not an SC231AI\n",
+			 hi, lo, sc->i2c->addr);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+/* The gain code's linear value in Q10. */
+static u32 sc231ai_code_gain(u32 code)
+{
+	return ((1024u << (code >> 4)) * (16 + (code & 15))) / 16;
+}
+
+static unsigned int sc231ai_again_index(u32 code)
+{
+	u32 want = sc231ai_code_gain(code);
+	unsigned int i = 0;
+
+	while (i + 1 < ARRAY_SIZE(sc231ai_again) &&
+	       sc231ai_again[i + 1].gain <= want)
+		i++;
+
+	return i;
+}
+
+static int sc231ai_commit_exposure(struct sc231ai *sc, u32 lines, u32 code)
+{
+	unsigned int idx = sc231ai_again_index(code);
+	u32 half;
+	int ret;
+
+	lines = clamp_t(u32, lines, SC231AI_EXPOSURE_MIN, SC231AI_EXPOSURE_MAX);
+	half = lines * 2;
+
+	ret = sc231ai_write(sc, SC231AI_REG_EXPOSURE_H, (half >> 12) & 0x0f);
+	if (!ret)
+		ret = sc231ai_write(sc, SC231AI_REG_EXPOSURE_M, (half >> 4) & 0xff);
+	if (!ret)
+		ret = sc231ai_write(sc, SC231AI_REG_EXPOSURE_L, (half & 0x0f) << 4);
+	if (!ret)
+		ret = sc231ai_write(sc, SC231AI_REG_AGAIN_COARSE,
+				    sc231ai_again[idx].coarse);
+	if (!ret)
+		ret = sc231ai_write(sc, SC231AI_REG_AGAIN_FINE,
+				    sc231ai_again[idx].fine);
+	if (!ret)
+		ret = sc231ai_write(sc, SC231AI_REG_DGAIN_COARSE,
+				    SC231AI_DGAIN_COARSE_1X);
+	if (!ret)
+		ret = sc231ai_write(sc, SC231AI_REG_DGAIN_FINE,
+				    SC231AI_DGAIN_FINE_1X);
+
+	return ret;
+}
+
+static int sc231ai_apply_live(void)
+{
+	struct sc231ai *sc;
+	int ret;
+
+	guard(mutex)(&sc231ai_bound_lock);
+
+	sc = sc231ai_bound;
+	if (!sc)
+		return 0;
+
+	if (sc->exposure)
+		__v4l2_ctrl_s_ctrl(sc->exposure, exposure);
+	if (sc->again)
+		__v4l2_ctrl_s_ctrl(sc->again, gain);
+
+	if (!pm_runtime_get_if_in_use(sc->dev))
+		return 0;
+
+	ret = sc231ai_commit_exposure(sc, exposure, gain);
+	pm_runtime_put(sc->dev);
+
+	return ret;
+}
+
+static int sc231ai_param_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+
+	/* Saturate rather than reject, like the NT99235 driver. */
+	exposure = clamp(exposure, SC231AI_EXPOSURE_MIN, SC231AI_EXPOSURE_MAX);
+	gain = clamp(gain, SC231AI_GAIN_CODE_MIN, SC231AI_GAIN_CODE_MAX);
+
+	return sc231ai_apply_live();
+}
+
+static const struct kernel_param_ops sc231ai_param_ops = {
+	.set = sc231ai_param_set,
+	.get = param_get_int,
+};
+
+module_param_cb(exposure, &sc231ai_param_ops, &exposure, 0644);
+MODULE_PARM_DESC(exposure,
+		 "integration time in lines, clamped to 1-1114 (frame length minus 11); writable while streaming");
+
+module_param_cb(gain, &sc231ai_param_ops, &gain, 0644);
+MODULE_PARM_DESC(gain,
+		 "gain code 0x00-0x60, gain = 2^(code>>4) * (16 + (code&15)) / 16 (the NT99235 driver's scale), 1x to 64x; writable while streaming");
+
+static u8 sc231ai_orientation_value(void)
+{
+	return (orientation & 1 ? SC231AI_ORIENTATION_MIRROR : 0) |
+	       (orientation & 2 ? SC231AI_ORIENTATION_FLIP : 0);
+}
+
+static int sc231ai_orientation_set(const char *val, const struct kernel_param *kp)
+{
+	struct sc231ai *sc;
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+	orientation &= 3;
+
+	guard(mutex)(&sc231ai_bound_lock);
+
+	sc = sc231ai_bound;
+	if (!sc || !pm_runtime_get_if_in_use(sc->dev))
+		return 0;
+
+	ret = sc231ai_write(sc, SC231AI_REG_ORIENTATION, sc231ai_orientation_value());
+	pm_runtime_put(sc->dev);
+
+	return ret;
+}
+
+static const struct kernel_param_ops sc231ai_orientation_ops = {
+	.set = sc231ai_orientation_set,
+	.get = param_get_int,
+};
+
+module_param_cb(orientation, &sc231ai_orientation_ops, &orientation, 0644);
+MODULE_PARM_DESC(orientation,
+		 "bit 0 mirror, bit 1 flip, 3 = turned 180 degrees (default 0, the vendor's default); writable while streaming, the Bayer phase stays");
+
+static int sc231ai_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc231ai *sc = container_of(ctrl->handler, struct sc231ai,
+					  ctrl_handler);
+
+	if (!pm_runtime_get_if_in_use(sc->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+	case V4L2_CID_ANALOGUE_GAIN:
+		sc231ai_commit_exposure(sc, sc->exposure->val, sc->again->val);
+		break;
+	}
+
+	pm_runtime_put(sc->dev);
+
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops sc231ai_ctrl_ops = {
+	.s_ctrl = sc231ai_s_ctrl,
+};
+
+static int sc231ai_start_stream(struct sc231ai *sc)
+{
+	int ret;
+
+	ret = sc231ai_write_regs(sc, sc231ai_regs_1920x1080p60,
+				 ARRAY_SIZE(sc231ai_regs_1920x1080p60));
+	if (ret)
+		return ret;
+
+	ret = sc231ai_write(sc, SC231AI_REG_ORIENTATION,
+			    sc231ai_orientation_value());
+	if (ret)
+		return ret;
+
+	if (test_pattern) {
+		u8 val;
+
+		ret = sc231ai_read(sc, SC231AI_REG_TEST_PATTERN, &val);
+		if (!ret)
+			ret = sc231ai_write(sc, SC231AI_REG_TEST_PATTERN,
+					    val | SC231AI_TEST_PATTERN_ENABLE);
+		if (ret)
+			return ret;
+		dev_info(sc->dev, "test pattern on\n");
+	}
+
+	ret = sc231ai_commit_exposure(sc, exposure, gain);
+	if (ret)
+		return ret;
+
+	return sc231ai_write(sc, SC231AI_REG_MODE_SELECT,
+			     SC231AI_MODE_STREAMING);
+}
+
+static int sc231ai_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct sc231ai *sc = to_sc231ai(sd);
+	int ret;
+
+	if (!enable) {
+		ret = sc231ai_write(sc, SC231AI_REG_MODE_SELECT,
+				    SC231AI_MODE_STANDBY);
+		pm_runtime_put(sc->dev);
+		return ret;
+	}
+
+	ret = pm_runtime_resume_and_get(sc->dev);
+	if (ret)
+		return ret;
+
+	ret = sc231ai_start_stream(sc);
+	if (ret)
+		pm_runtime_put(sc->dev);
+
+	return ret;
+}
+
+static void sc231ai_fill_format(struct v4l2_mbus_framefmt *format)
+{
+	format->width = SC231AI_WIDTH;
+	format->height = SC231AI_HEIGHT;
+	format->code = SC231AI_MBUS_CODE;
+	format->field = V4L2_FIELD_NONE;
+	format->colorspace = V4L2_COLORSPACE_RAW;
+	format->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	format->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	format->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int sc231ai_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = SC231AI_MBUS_CODE;
+
+	return 0;
+}
+
+static int sc231ai_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *sd_state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index > 0 || fse->code != SC231AI_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = SC231AI_WIDTH;
+	fse->max_width = SC231AI_WIDTH;
+	fse->min_height = SC231AI_HEIGHT;
+	fse->max_height = SC231AI_HEIGHT;
+
+	return 0;
+}
+
+/* One mode: any request gets it. */
+static int sc231ai_set_pad_format(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_format *fmt)
+{
+	sc231ai_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(sd_state, fmt->pad) = fmt->format;
+
+	return 0;
+}
+
+static int sc231ai_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *sd_state)
+{
+	sc231ai_fill_format(v4l2_subdev_state_get_format(sd_state, 0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops sc231ai_video_ops = {
+	.s_stream = sc231ai_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops sc231ai_pad_ops = {
+	.enum_mbus_code = sc231ai_enum_mbus_code,
+	.enum_frame_size = sc231ai_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc231ai_set_pad_format,
+};
+
+static const struct v4l2_subdev_ops sc231ai_subdev_ops = {
+	.video = &sc231ai_video_ops,
+	.pad = &sc231ai_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc231ai_internal_ops = {
+	.init_state = sc231ai_init_state,
+};
+
+/* The mode needs two lanes; an endpoint with fewer cannot carry it. */
+static int sc231ai_check_endpoint(struct sc231ai *sc)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int lanes;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(sc->dev), NULL);
+	if (!endpoint) {
+		dev_err(sc->dev, "no endpoint in the device tree node\n");
+		return -ENXIO;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	lanes = bus_cfg.bus.mipi_csi2.num_data_lanes;
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	if (lanes < SC231AI_LANES) {
+		dev_err(sc->dev, "the mode needs %u data lanes, the endpoint has %u\n",
+			SC231AI_LANES, lanes);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int sc231ai_init_controls(struct sc231ai *sc)
+{
+	static const s64 link_freqs[] = { SC231AI_LINK_FREQ };
+	struct v4l2_ctrl_handler *handler = &sc->ctrl_handler;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(handler, 4);
+	if (ret)
+		return ret;
+
+	ctrl = v4l2_ctrl_new_int_menu(handler, NULL, V4L2_CID_LINK_FREQ,
+				      0, 0, link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ctrl = v4l2_ctrl_new_std(handler, NULL, V4L2_CID_PIXEL_RATE,
+				 SC231AI_PIXEL_RATE, SC231AI_PIXEL_RATE, 1,
+				 SC231AI_PIXEL_RATE);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc->exposure = v4l2_ctrl_new_std(handler, &sc231ai_ctrl_ops,
+					 V4L2_CID_EXPOSURE,
+					 SC231AI_EXPOSURE_MIN,
+					 SC231AI_EXPOSURE_MAX, 1, exposure);
+
+	sc->again = v4l2_ctrl_new_std(handler, &sc231ai_ctrl_ops,
+				      V4L2_CID_ANALOGUE_GAIN,
+				      SC231AI_GAIN_CODE_MIN,
+				      SC231AI_GAIN_CODE_MAX, 1, gain);
+
+	if (handler->error) {
+		ret = handler->error;
+		v4l2_ctrl_handler_free(handler);
+		return ret;
+	}
+
+	sc->sd.ctrl_handler = handler;
+
+	return 0;
+}
+
+static void sc231ai_unregister_ancillary(void *client)
+{
+	i2c_unregister_device(client);
+}
+
+static int sc231ai_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sc231ai *sc;
+	int ret;
+
+	sc = devm_kzalloc(dev, sizeof(*sc), GFP_KERNEL);
+	if (!sc)
+		return -ENOMEM;
+
+	sc->dev = dev;
+	v4l2_i2c_subdev_init(&sc->sd, client, &sc231ai_subdev_ops);
+	sc->sd.internal_ops = &sc231ai_internal_ops;
+
+	if (client->addr == SC231AI_I2C_ADDR) {
+		sc->i2c = client;
+	} else {
+		sc->i2c = i2c_new_ancillary_device(client, "sc231ai",
+						   SC231AI_I2C_ADDR);
+		if (IS_ERR(sc->i2c))
+			return dev_err_probe(dev, PTR_ERR(sc->i2c),
+					     "no client at the SC231AI address\n");
+
+		ret = devm_add_action_or_reset(dev, sc231ai_unregister_ancillary,
+					       sc->i2c);
+		if (ret)
+			return ret;
+	}
+
+	ret = sc231ai_check_endpoint(sc);
+	if (ret)
+		return ret;
+
+	sc->mclk = devm_clk_get(dev, "mclk");
+	if (IS_ERR(sc->mclk))
+		return dev_err_probe(dev, PTR_ERR(sc->mclk),
+				     "failed to get the master clock\n");
+
+	if (clk_get_rate(sc->mclk) != SC231AI_MCLK_RATE)
+		dev_warn(dev, "master clock is %lu Hz, the sensor expects %u Hz\n",
+			 clk_get_rate(sc->mclk), SC231AI_MCLK_RATE);
+
+	sc->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_ASIS);
+	if (IS_ERR(sc->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc->enable_gpio),
+				     "failed to get the enable gpio\n");
+
+	sc->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(sc->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc->reset_gpio),
+				     "failed to get the reset gpio\n");
+
+	/* Is it this sensor? Power up just long enough to read the id. */
+	ret = sc231ai_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc231ai_detect(sc);
+	sc231ai_power_off(dev);
+	if (ret)
+		return ret;
+
+	ret = sc231ai_init_controls(sc);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register the controls\n");
+
+	sc->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc->pad.flags = MEDIA_PAD_FL_SOURCE;
+	sc->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&sc->sd.entity, 1, &sc->pad);
+	if (ret)
+		goto error_controls;
+
+	ret = v4l2_subdev_init_finalize(&sc->sd);
+	if (ret)
+		goto error_media_entity;
+
+	pm_runtime_set_suspended(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc->sd);
+	if (ret)
+		goto error_pm;
+
+	scoped_guard(mutex, &sc231ai_bound_lock)
+		sc231ai_bound = sc;
+
+	dev_info(dev, "SC231AI at 0x%02x, 1920x1080p60 RAW10 on %u lanes, exposure %d gain 0x%02x\n",
+		 sc->i2c->addr, SC231AI_LANES, exposure, gain);
+
+	return 0;
+
+error_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sc->sd);
+error_media_entity:
+	media_entity_cleanup(&sc->sd.entity);
+error_controls:
+	v4l2_ctrl_handler_free(&sc->ctrl_handler);
+
+	return ret;
+}
+
+static void sc231ai_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc231ai *sc = to_sc231ai(sd);
+	struct device *dev = &client->dev;
+
+	scoped_guard(mutex, &sc231ai_bound_lock)
+		sc231ai_bound = NULL;
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc->ctrl_handler);
+
+	pm_runtime_disable(dev);
+	if (!pm_runtime_status_suspended(dev))
+		sc231ai_power_off(dev);
+	pm_runtime_set_suspended(dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(sc231ai_pm_ops, sc231ai_power_off,
+				 sc231ai_power_on, NULL);
+
+static const struct of_device_id sc231ai_of_match[] = {
+	{ .compatible = "smartsens,sc231ai" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sc231ai_of_match);
+
+static struct i2c_driver sc231ai_driver = {
+	.probe = sc231ai_probe,
+	.remove = sc231ai_remove,
+	.driver = {
+		.name = "sc231ai",
+		.pm = pm_ptr(&sc231ai_pm_ops),
+		.of_match_table = sc231ai_of_match,
+	},
+};
+module_i2c_driver(sc231ai_driver);
+
+MODULE_DESCRIPTION("SmartSens SC231AI image sensor subdev");
+MODULE_LICENSE("GPL");
