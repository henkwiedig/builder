--- a/drivers/media/artosyn/Makefile
+++ b/drivers/media/artosyn/Makefile
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0
 
 obj-$(CONFIG_VIDEO_ARTOSYN_NT99235) += nt99235.o
+obj-$(CONFIG_VIDEO_ARTOSYN_SC231AI) += sc231ai.o
 obj-$(CONFIG_VIDEO_ARTOSYN_CSI2) += ar-csi2.o
 obj-$(CONFIG_VIDEO_ARTOSYN_VIF) += ar-vif.o
