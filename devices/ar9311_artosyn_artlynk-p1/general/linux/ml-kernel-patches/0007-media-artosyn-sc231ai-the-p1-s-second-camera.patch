+int ar_isp_pipeline_start(const struct v4l2_mbus_framefmt *fmt);
 
 #endif /* AR_CAMERA_HOOK_H */
diff --git a/drivers/media/artosyn/ar-csi2.c b/drivers/media/artosyn/ar-csi2.c
index 0d23d5b..c49a1a9 100644
--- a/drivers/media/artosyn/ar-csi2.c
+++ b/drivers/media/artosyn/ar-csi2.c
@@ -130,12 +130,17 @@
 
 /* IPI horizontal timings. In camera timing mode these set the blanking the IPI
  * inserts; they are a property of the sensor mode rather than of the receiver.
- * Vendor values for the 1920x1080 two-lane RAW12 mode, read back from
- * hardware.
+ * The P1's two sensors each have one mode and differ in data type, so the
+ * data type selects them: the NT99235's 1920x1080 two-lane RAW12 values were
+ * read back from the vendor's hardware, the SC231AI's 1920x1080 two-lane
+ * RAW10 values are the ones fpvOS measured for it.
  */
 #define AR_CSI_IPI_HSA_TIME		0x1c
 #define AR_CSI_IPI_HBP_TIME		0x1c
 #define AR_CSI_IPI_HSD_TIME		0x39
+#define AR_CSI_IPI_HSA_TIME_RAW10	16
+#define AR_CSI_IPI_HBP_TIME_RAW10	16
+#define AR_CSI_IPI_HSD_TIME_RAW10	33
 
 /* The version this driver has been checked against. */
 #define DW_CSI2_VERSION_1_20		0x3132302a
@@ -503,7 +508,7 @@ static void ar_csi2_phy_power_off(struct ar_csi2 *csi2)
 }
 
 /* Program the wrapper and the core for one CSI-2 link. data_type is the CSI-2
- * data type the sensor emits (0x2c for RAW12).
+ * data type the sensor emits (0x2b for RAW10, 0x2c for RAW12).
  */
 static void ar_csi2_configure(struct ar_csi2 *csi2, u8 data_type)
 {
@@ -557,9 +562,15 @@ static void ar_csi2_configure(struct ar_csi2 *csi2, u8 data_type)
 	ar_csi2_write(csi2->core, DW_CSI2_IPI_VCID, 0);
 	ar_csi2_write(csi2->core, DW_CSI2_IPI_DATA_TYPE, data_type);
 	ar_csi2_write(csi2->core, DW_CSI2_IPI_MEM_FLUSH, DW_CSI2_IPI_MEM_AUTO_FLUSH);
-	ar_csi2_write(csi2->core, DW_CSI2_IPI_HSA_TIME, AR_CSI_IPI_HSA_TIME);
-	ar_csi2_write(csi2->core, DW_CSI2_IPI_HBP_TIME, AR_CSI_IPI_HBP_TIME);
-	ar_csi2_write(csi2->core, DW_CSI2_IPI_HSD_TIME, AR_CSI_IPI_HSD_TIME);
+	if (data_type == MIPI_CSI2_DT_RAW10) {
+		ar_csi2_write(csi2->core, DW_CSI2_IPI_HSA_TIME, AR_CSI_IPI_HSA_TIME_RAW10);
+		ar_csi2_write(csi2->core, DW_CSI2_IPI_HBP_TIME, AR_CSI_IPI_HBP_TIME_RAW10);
+		ar_csi2_write(csi2->core, DW_CSI2_IPI_HSD_TIME, AR_CSI_IPI_HSD_TIME_RAW10);
+	} else {
+		ar_csi2_write(csi2->core, DW_CSI2_IPI_HSA_TIME, AR_CSI_IPI_HSA_TIME);
+		ar_csi2_write(csi2->core, DW_CSI2_IPI_HBP_TIME, AR_CSI_IPI_HBP_TIME);
+		ar_csi2_write(csi2->core, DW_CSI2_IPI_HSD_TIME, AR_CSI_IPI_HSD_TIME);
+	}
 
 	/* Route the IPI output. Both mux registers read zero on a running
 	 * vendor link with this single-instance configuration.
@@ -623,6 +634,31 @@ static void ar_csi2_report_lanes(struct ar_csi2 *csi2)
 	}
 }
 
+/* The CSI-2 data type the sensor emits, from its active pad format. The P1
+ * fits either an NT99235 (RAW12) or an SC231AI (RAW10); anything that does not
+ * name a 10-bit Bayer code keeps the RAW12 the receiver was brought up on.
+ */
+static u8 ar_csi2_source_data_type(struct ar_csi2 *csi2)
+{
+	struct v4l2_subdev_format format = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		.pad = csi2->sensor_source_pad,
+	};
+
+	if (v4l2_subdev_call_state_active(csi2->sensor, pad, get_fmt, &format))
+		return MIPI_CSI2_DT_RAW12;
+
+	switch (format.format.code) {
+	case MEDIA_BUS_FMT_SBGGR10_1X10:
+	case MEDIA_BUS_FMT_SGBRG10_1X10:
+	case MEDIA_BUS_FMT_SGRBG10_1X10:
+	case MEDIA_BUS_FMT_SRGGB10_1X10:
+		return MIPI_CSI2_DT_RAW10;
+	default:
+		return MIPI_CSI2_DT_RAW12;
+	}
+}
+
 static int ar_csi2_set_stream(struct v4l2_subdev *sd, int enable)
 {
 	struct ar_csi2 *csi2 = to_ar_csi2(sd);
@@ -643,10 +679,7 @@ static int ar_csi2_set_stream(struct v4l2_subdev *sd, int enable)
 	if (ret)
 		return ret;
 
-	/* RAW12 is the only format the sensor emits, so the data type is
-	 * fixed; a multi-format sensor would derive it from the pad format.
-	 */
-	ar_csi2_configure(csi2, MIPI_CSI2_DT_RAW12);
+	ar_csi2_configure(csi2, ar_csi2_source_data_type(csi2));
 
 	ret = v4l2_subdev_call(csi2->sensor, video, s_stream, 1);
 	if (ret) {
diff --git a/drivers/media/artosyn/ar-cvisp.c b/drivers/media/artosyn/ar-cvisp.c
index 13d94e8..4ed766d 100644
--- a/drivers/media/artosyn/ar-cvisp.c
+++ b/drivers/media/artosyn/ar-cvisp.c
@@ -169,7 +169,15 @@ module_param(fpn, bool, 0644);
 MODULE_PARM_DESC(fpn,
 		 "clear fpn's enable bit as the vendor's tuning apply does (default on)");
 
-/* Reads AR_CVISP_TUNING_FIRMWARE. */
+/* The sensor tuning file BLC reads its ladder from: AR_CVISP_TUNING_FIRMWARE,
+ * or the bound sensor's file on boards that fit either of two sensors.
+ */
+static char *tuning;
+module_param(tuning, charp, 0444);
+MODULE_PARM_DESC(tuning,
+		 "tuning file BLC reads instead of " AR_CVISP_TUNING_FIRMWARE);
+
+/* Reads the tuning file (see tuning). */
 static bool blc = true;
 module_param(blc, bool, 0644);
 MODULE_PARM_DESC(blc,
@@ -499,11 +507,12 @@ static void ar_cvisp_blc_apply(struct ar_cvisp *cv)
 	if (!blc)
 		return;
 
-	int ret = request_firmware(&fw, AR_CVISP_TUNING_FIRMWARE, cv->dev);
+	const char *name = tuning && *tuning ? tuning : AR_CVISP_TUNING_FIRMWARE;
+	int ret = request_firmware(&fw, name, cv->dev);
 
 	if (ret) {
 		dev_info(cv->dev, "blc: no %s (%d), leaving the replayed constants\n",
-			 AR_CVISP_TUNING_FIRMWARE, ret);
+			 name, ret);
 		return;
 	}
 
@@ -864,7 +873,15 @@ static int ar_cvisp_chain_start(struct ar_cvisp *cv)
 		return ret;
 	}
 
-	ret = ar_isp_pipeline_start();
+	struct v4l2_mbus_framefmt fmt;
+
+	ret = ar_vif_source_format(&fmt);
+	if (ret) {
+		dev_err(cv->dev, "cannot read the input format (%d)\n", ret);
+		return ret;
+	}
+
+	ret = ar_isp_pipeline_start(&fmt);
 	if (ret) {
 		dev_err(cv->dev, "cannot start the isp (%d)\n", ret);
 		return ret;
diff --git a/drivers/media/artosyn/ar-isp-main.c b/drivers/media/artosyn/ar-isp-main.c
index b5c849b..e592a56 100644
--- a/drivers/media/artosyn/ar-isp-main.c
+++ b/drivers/media/artosyn/ar-isp-main.c
@@ -33,6 +33,7 @@
  * records the remaining device-sourced groups.
  */
 
+#include <linux/bitfield.h>
 #include <linux/clk.h>
 #include <linux/debugfs.h>
 #include <linux/delay.h>
@@ -43,7 +44,10 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/seq_file.h>
 #include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <media/v4l2-mediabus.h>
 
 #include "vendor-tables/ar-isp-defaults.h"
 #include "vendor-tables/ar-isp-gates.h"
@@ -743,6 +747,103 @@ DEFINE_DEBUGFS_ATTRIBUTE(ar_isp_tone_fops, NULL, ar_isp_tone_set, "%llu\n");
  */
 static struct ar_isp *ar_isp_instance;
 
+/*
+ * White balance gains, Q8 (256 is 1.0), written at every pipeline start. 0
+ * leaves a gain as the replay left it, which is 1.0. They depend on the sensor
+ * and the light, so the camera loader passes the bound sensor's values; the
+ * white_balance debugfs file changes them on a running pipeline.
+ */
+static unsigned int wb_red;
+module_param(wb_red, uint, 0644);
+MODULE_PARM_DESC(wb_red, "red gain, Q8 (256 = 1.0), 0 to leave the replayed 1.0");
+
+static unsigned int wb_green;
+module_param(wb_green, uint, 0644);
+MODULE_PARM_DESC(wb_green, "green gain, Q8 (256 = 1.0), 0 to leave the replayed 1.0");
+
+static unsigned int wb_blue;
+module_param(wb_blue, uint, 0644);
+MODULE_PARM_DESC(wb_blue, "blue gain, Q8 (256 = 1.0), 0 to leave the replayed 1.0");
+
+static void ar_isp_wb_write(struct ar_isp *isp, u32 red, u32 green, u32 blue)
+{
+	if (!red && !green && !blue)
+		return;
+	if (red)
+		writel(clamp(red, AR_ISP_WB_GAIN_MIN, AR_ISP_WB_GAIN_MAX),
+		       isp->base + AR_ISP_WB_GAIN_R);
+	if (green)
+		writel(clamp(green, AR_ISP_WB_GAIN_MIN, AR_ISP_WB_GAIN_MAX),
+		       isp->base + AR_ISP_WB_GAIN_G);
+	if (blue)
+		writel(clamp(blue, AR_ISP_WB_GAIN_MIN, AR_ISP_WB_GAIN_MAX),
+		       isp->base + AR_ISP_WB_GAIN_B);
+	writel(AR_ISP_WB_LATCH, isp->base + AR_ISP_WB_UPDATE);
+}
+
+/* The input formats the block has a setup for: the P1's two sensors. */
+static bool ar_isp_input_supported(u32 code)
+{
+	return code == MEDIA_BUS_FMT_SRGGB12_1X12 ||	/* NT99235 */
+	       code == MEDIA_BUS_FMT_SBGGR10_1X10;	/* SC231AI */
+}
+
+/*
+ * The input-dependent part of the setup, after the output arm. The replay is
+ * the NT99235's, so that sensor needs nothing here. The SC231AI sends RAW10 at
+ * exactly its 1920x1080 active area, which needs the borderless input mode,
+ * its own Bayer order and the second DRC length; all three found by fpvOS.
+ * Without the input mode every frame aborts in the ISP.
+ */
+static void ar_isp_input_setup(struct ar_isp *isp,
+			       const struct v4l2_mbus_framefmt *fmt)
+{
+	u32 val;
+
+	if (fmt->code == MEDIA_BUS_FMT_SBGGR10_1X10) {
+		val = readl(isp->base + AR_ISP_INPUT_SIZE);
+		val &= ~(AR_ISP_INPUT_MODE | AR_ISP_INPUT_HEIGHT | AR_ISP_INPUT_WIDTH);
+		val |= FIELD_PREP(AR_ISP_INPUT_MODE, AR_ISP_INPUT_MODE_NO_BORDER) |
+		       FIELD_PREP(AR_ISP_INPUT_HEIGHT, fmt->height) |
+		       FIELD_PREP(AR_ISP_INPUT_WIDTH, fmt->width);
+		writel(val, isp->base + AR_ISP_INPUT_SIZE);
+
+		writel(fmt->width << 15 | fmt->height << 2 | 2,
+		       isp->base + AR_ISP_CFA_GEOMETRY);
+		val = readl(isp->base + AR_ISP_CFA_ORDER);
+		val = (val & ~AR_ISP_CFA_ORDER_MASK) | 2;
+		writel(val, isp->base + AR_ISP_CFA_ORDER);
+
+		/* A command, not a status: no completion to wait for. */
+		writel(AR_ISP_TABLE_DRC_LEN_VALUE, isp->base + AR_ISP_TABLE_DRC_LEN0);
+		writel(AR_ISP_TABLE_DRC_LEN_VALUE, isp->base + AR_ISP_TABLE_DRC_LEN1);
+		writel(AR_ISP_TABLE_COMMIT_ENABLE | AR_ISP_TABLE_GAMMA_BITS |
+		       AR_ISP_TABLE_DRC_BIT, isp->base + AR_ISP_TABLE_COMMIT);
+	}
+
+	/* The output arm's control word clears the black level enable; put
+	 * back what the tuning file asks for.
+	 */
+	if (isp->tuning) {
+		val = readl(isp->base + AR_ISP_CONTROL);
+		if (ar_isp_get_le32(isp->tuning->data + AR_ISP_BLOB_BLC_ENABLE))
+			val |= AR_ISP_CONTROL_BLC;
+		else
+			val &= ~AR_ISP_CONTROL_BLC;
+		writel(val, isp->base + AR_ISP_CONTROL);
+	}
+
+	ar_isp_wb_write(isp, wb_red, wb_green, wb_blue);
+
+	dev_info(isp->dev, "input 0x%04x %ux%u: size 0x%08x, control 0x%08x, wb %u/%u/%u\n",
+		 fmt->code, fmt->width, fmt->height,
+		 readl(isp->base + AR_ISP_INPUT_SIZE),
+		 readl(isp->base + AR_ISP_CONTROL),
+		 readl(isp->base + AR_ISP_WB_GAIN_R),
+		 readl(isp->base + AR_ISP_WB_GAIN_G),
+		 readl(isp->base + AR_ISP_WB_GAIN_B));
+}
+
 /*
  * Configure the block and arm its output, as one call for a driver that is
  * bringing the whole chain up.
@@ -754,20 +855,84 @@ static struct ar_isp *ar_isp_instance;
  *
  * The caller must have the pixel domain live already: this reads registers back.
  */
-int ar_isp_pipeline_start(void)
+int ar_isp_pipeline_start(const struct v4l2_mbus_framefmt *fmt)
 {
 	struct ar_isp *isp = READ_ONCE(ar_isp_instance);
 
 	if (!isp)
 		return -ENODEV;
 
+	if (!ar_isp_input_supported(fmt->code)) {
+		dev_err(isp->dev, "no input setup for bus format 0x%04x\n",
+			fmt->code);
+		return -EINVAL;
+	}
+
 	ar_isp_configure_prefix(isp, setup_entries);
 	ar_isp_arm_output(isp);
+	ar_isp_input_setup(isp, fmt);
 
 	return 0;
 }
 EXPORT_SYMBOL_GPL(ar_isp_pipeline_start);
 
+/*
+ * Live white balance for a running pipeline: "red green blue" in Q8, 0 to
+ * leave a gain alone; reads back the three registers. For a userspace AWB
+ * loop. -EPIPE before the block is configured, where a register access could
+ * hang the SoC.
+ */
+static int ar_isp_wb_show(struct seq_file *s, void *unused)
+{
+	struct ar_isp *isp = s->private;
+
+	if (!isp->configured)
+		return -EPIPE;
+
+	seq_printf(s, "%u %u %u\n", readl(isp->base + AR_ISP_WB_GAIN_R),
+		   readl(isp->base + AR_ISP_WB_GAIN_G),
+		   readl(isp->base + AR_ISP_WB_GAIN_B));
+
+	return 0;
+}
+
+static int ar_isp_wb_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ar_isp_wb_show, inode->i_private);
+}
+
+static ssize_t ar_isp_wb_store(struct file *file, const char __user *ubuf,
+			       size_t len, loff_t *ppos)
+{
+	struct ar_isp *isp = ((struct seq_file *)file->private_data)->private;
+	unsigned int red, green, blue;
+	char buf[48];
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	if (sscanf(buf, "%u %u %u", &red, &green, &blue) != 3)
+		return -EINVAL;
+	if (!isp->configured)
+		return -EPIPE;
+
+	ar_isp_wb_write(isp, red, green, blue);
+
+	return len;
+}
+
+static const struct file_operations ar_isp_wb_fops = {
+	.owner = THIS_MODULE,
+	.open = ar_isp_wb_open,
+	.read = seq_read,
+	.write = ar_isp_wb_store,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
 DEFINE_DEBUGFS_ATTRIBUTE(ar_isp_prefix_fops, ar_isp_prefix_get,
 			 ar_isp_prefix_set, "%llu\n");
 
