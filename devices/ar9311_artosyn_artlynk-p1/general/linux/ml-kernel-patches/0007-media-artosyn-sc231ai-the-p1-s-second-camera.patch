index 0000000..e168965
--- /dev/null
+++ b/drivers/media/artosyn/sc231ai.c
@@ -0,0 +1,940 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * sc231ai.c - SmartSens SC231AI MIPI CSI-2 image sensor subdev.
+ *
+ * BetaFPV builds the P1 air unit with one of two camera modules on the same
+ * connector: an NT99235 at i2c 0x1a or an SC231AI at i2c 0x30. Both share the
+ * connector's power-enable and reset lines and the 24 MHz master clock, and the
+ * vendor firmware probes for each in turn. This driver covers the SC231AI.
+ *
+ * Everything sensor-specific comes from the vendor sensor library
+ * libsns_sc231ai.so (P1_SKY v1.0.36 to v2.0.5): the one mode it supports
+ * (linear 1920x1080 at 60 fps, 10-bit, two lanes), the power sequence, the
+ * exposure, gain and frame-length registers its AE writes, and the chip id its
+ * probe checks. The library programs the mode as inline register writes; the
+ * table below is a mechanical transcription in program order.
+ *
+ * The device tree node may carry this sensor alone (reg = <0x30>) or be shared
+ * with the NT99235 (compatible lists both, reg = <0x1a>, <0x30> with reg-names).
+ * In the shared case the client the core creates sits at the NT99235 address
+ * and this driver talks to its own address through an ancillary client. Probe
+ * reads the chip id so that whichever driver finds its sensor binds the node
+ * and the other steps aside with -ENODEV.
+ */
+
+#include <linux/cleanup.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm_runtime.h>
+
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define SC231AI_I2C_ADDR		0x30
+
+/* Chip id, as the vendor probe checks it: 0x3107 = 0xcb, 0x3108 = 0x6a. */
+#define SC231AI_REG_CHIP_ID_HI		0x3107
+#define SC231AI_REG_CHIP_ID_LO		0x3108
+#define SC231AI_CHIP_ID			0xcb6a
+
+#define SC231AI_REG_MODE_SELECT		0x0100
+#define SC231AI_MODE_STANDBY		0x00
+#define SC231AI_MODE_STREAMING		0x01
+
+/*
+ * The registers the vendor AE commits (cmos_get_sns_regs_info).
+ *
+ * Exposure is counted in half lines: the vendor clamps the line count to
+ * [1, frame length - 11], doubles it and spreads the 16-bit result as
+ * 0x3e00[3:0] = bits 15:12, 0x3e01 = bits 11:4, 0x3e02[7:4] = bits 3:0.
+ *
+ * Analogue gain is a coarse/fine pair at 0x3e08/0x3e09, digital gain another
+ * pair at 0x3e06/0x3e07 (1x is 0x00/0x80). The frame length is 0x320e/0x320f.
+ */
+#define SC231AI_REG_EXPOSURE_H		0x3e00
+#define SC231AI_REG_EXPOSURE_M		0x3e01
+#define SC231AI_REG_EXPOSURE_L		0x3e02
+#define SC231AI_REG_DGAIN_COARSE	0x3e06
+#define SC231AI_REG_DGAIN_FINE		0x3e07
+#define SC231AI_REG_AGAIN_COARSE	0x3e08
+#define SC231AI_REG_AGAIN_FINE		0x3e09
+#define SC231AI_DGAIN_COARSE_1X		0x00
+#define SC231AI_DGAIN_FINE_1X		0x80
+
+/*
+ * Mirror and flip, 0x3221: the vendor's sensor control 7 writes 0x00, 0x06,
+ * 0x60 or 0x66 for its four orientations. The ISP sees the same Bayer order
+ * in all four (tested on a P1): the sensor moves its readout to hold the
+ * phase, and the frame still arrives top-down. So this is where a picture is
+ * turned, rather than in the encoder.
+ */
+#define SC231AI_REG_ORIENTATION		0x3221
+
+/*
+ * Test pattern: 0x4501 bit 3, as Rockchip's driver for this chip (SC231HAI,
+ * same chip ID) switches it; the vendor library never does. On a P1 it is a
+ * ramp across the width with all four Bayer channels equal, which makes it a
+ * neutral reference for the ISP: with unity white balance it must come out
+ * grey at every level.
+ */
+#define SC231AI_REG_TEST_PATTERN	0x4501
+#define SC231AI_TEST_PATTERN_ENABLE	BIT(3)
+#define SC231AI_ORIENTATION_MIRROR	0x06
+#define SC231AI_ORIENTATION_FLIP	0x60
