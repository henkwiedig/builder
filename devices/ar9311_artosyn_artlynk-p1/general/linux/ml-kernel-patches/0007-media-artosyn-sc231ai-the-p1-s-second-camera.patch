+static const struct sc231ai_reg sc231ai_regs_1920x1080p60[] = {
+	{ 0x0103, 0x01 }, { 0x36e9, 0x80 }, { 0x37f9, 0x80 }, { 0x301f, 0x43 },
+	{ 0x3058, 0x21 }, { 0x3059, 0x53 }, { 0x305a, 0x40 }, { 0x3200, 0x00 },
