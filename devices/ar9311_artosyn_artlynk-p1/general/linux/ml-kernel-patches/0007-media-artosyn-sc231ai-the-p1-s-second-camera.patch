+#define SC231AI_EXPOSURE_MARGIN		11
+#define SC231AI_EXPOSURE_MIN		1
+#define SC231AI_EXPOSURE_MAX		(SC231AI_VTS - SC231AI_EXPOSURE_MARGIN)
+
+/*
+ * The gain parameter uses the NT99235 driver's code scale, so one AE loop
+ * drives either sensor: gain = 2^(code >> 4) * (16 + (code & 15)) / 16, 1x at
+ * 0x00 to 64x at 0x60. The driver converts it to the nearest analogue setting
+ * at or below that gain. The SC231AI's analogue range reaches 116x, so the
+ * whole code range is analogue and digital gain stays at 1x.
+ */
+#define SC231AI_GAIN_CODE_MIN		0x00
+#define SC231AI_GAIN_CODE_MAX		0x60
+#define SC231AI_GAIN_CODE_DEFAULT	0x3c
+
+#define SC231AI_MCLK_RATE		24000000
+#define SC231AI_RESET_SETTLE_US		10000
+
+/*
+ * Per-lane rate 742.5 Mbit/s: the mode's frame is 2240 x 1125 at 60 fps and
+ * moves 1920 10-bit pixels a line over two lanes. The link frequency is half
+ * the per-lane rate (both clock edges carry data); the pixel rate follows from
+ * it the usual way, link_freq * 2 * lanes / bits per pixel.
+ */
+#define SC231AI_LANES			2
+#define SC231AI_LINK_FREQ		371250000LL
+#define SC231AI_PIXEL_RATE		148500000ULL
+
