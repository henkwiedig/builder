diff --git a/drivers/media/artosyn/ar-camera-hook.h b/drivers/media/artosyn/ar-camera-hook.h
index 47b03bd..627d6cc 100644
--- a/drivers/media/artosyn/ar-camera-hook.h
+++ b/drivers/media/artosyn/ar-camera-hook.h
@@ -44,9 +44,17 @@ int ar_vif_input_start(void);
 void ar_vif_input_stop(void);
 
 /*
- * Configure the ISP and arm its output. Must be called with the input path
- * already live. -ENODEV if the ISP has not probed.
+ * The format the sensor delivers, as the VIF sees it on its sink. -ENODEV if
