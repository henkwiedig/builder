# BetaFPV P1 SKY / Artosyn ArtLynk air unit, Artosyn PROXIMA 9311 (AR9311).
#
# Quad Cortex-A53, 256 MiB DDR, 128 MiB SPI-NAND, AR8030 baseband on SDIO
# (mmc0@01b00000, reset on GPIO23), dwc2 OTG USB, NT99235 camera, no PHY.
#
# Kernel: mainline 6.18.36 + MissingLynk's open Proxima-9311 BSP
# (package/ml-kernel, applied by general/linux/linux-ext-ml-kernel.mk; board
# "betafpv-vr04-air" = P1_SKY). Artosyn has published no kernel source.
#
# Userland: the hi3516cv6xx_artosyn_caddx-ascent-lite (Ascent) set, minus what is
# HiSilicon-only (hisilicon-opensdk/osdrv; openipc-bsel, which flips CADDX's
# fpvboot bank). waybeam and msposd build their V4L2 (ar9311) and
# forward-only (headless) targets here: the camera and the wave5 codec are
# V4L2 devices on this kernel.

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="artosyn"
BR2_OPENIPC_SOC_MODEL="ar9311"
BR2_OPENIPC_SOC_FAMILY="ar9311"
# The variant names the transport, as wfbng, rubyfpv and apfpv do: the Artosyn
# AR8030 baseband (same as hi3516cv6xx_artosyn_caddx-ascent-lite). It only
# feeds the image name, the excludes filename (ar9311_artosyn.list) and
# os-release BUILD_OPTION/BUILD_PLATFORM.
BR2_OPENIPC_VARIANT="artosyn"
BR2_OPENIPC_FLASH_SIZE="16"

# Architecture
BR2_aarch64=y
BR2_cortex_a53=y

# Toolchain: built by Buildroot. There is no OpenIPC toolchain tarball for
# artosyn-ar9311, and the only aarch64 one (hi3519dv500) targets Cortex-A55.
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_VENDOR="openipc"
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_6_6=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_13_X=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.36.tar.xz"
# arch/arm64/configs/ml_defconfig, written by linux-ext-ml-kernel.mk from
# ml-kernel's fragments for the board; board/ar9311/openipc.config adds what
# the OpenIPC userland needs on top.
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="ml"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/openipc.config"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="artosyn/proxima-9311-air"
BR2_PACKAGE_ML_KERNEL=y
BR2_PACKAGE_ML_KERNEL_BOARD="betafpv-vr04-air"
BR2_PACKAGE_ML_KERNEL_MODULES=y
BR2_PACKAGE_ML_KERNEL_MODULES_PRUNE=y
# post-image.sh packs the Image into the stock OTRA + LZ4 uImage container
# the stock U-Boot/SPL boot (see that script); ml-kernel pulls in host-lz4.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/post-image.sh"

# Stock-image blobs: the P1 RF config (power/PA calibration, for the
# generated p1_ascent_air.json, installed as ar8030/ar8030.json by the ar8030
# package), Wave521C codec firmware, NT99235 ISP tuning, and the
# SPL/U-Boot/DDR firmware used to USB-boot a board.
BR2_PACKAGE_ARTLYNK_P1_VENDOR_FIRMWARE=y

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_UBOOT_TOOLS=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# rootfs.cpio.gz: RAM boot over USB (ROM loader -> U-Boot -> bootm with it
# as initrd), for boards without flash.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# NAND install (slot B): the rootfs as UBIFS, which post-image.sh ubinizes
# with an empty rootfs_data overlay into rootfs.ubi for userapp1 (see
# board/ar9311/ubinize.cfg). SPI-NAND XT26Q01D: 128 KiB PEB, 2 KiB page and
# sub-page, so 124 KiB LEBs; at most 360 of them, userapp1's size.
# BR2_TARGET_ROOTFS_UBI stays off: firmware's repack runs its generic NAND
# branch for any UBI build, and that wants an output/images/uImage of at
# most 4 MiB -- the P1's kernel is the ~6 MB OTRA container uImage.ar9311.
BR2_TARGET_ROOTFS_UBIFS=y
BR2_TARGET_ROOTFS_UBIFS_LEBSIZE=0x1f000
BR2_TARGET_ROOTFS_UBIFS_MINIOSIZE=0x800
BR2_TARGET_ROOTFS_UBIFS_MAXLEBCNT=360
# BR2_TARGET_ROOTFS_UBI is not set

# Packages (the Ascent set, see header)
BR2_PACKAGE_AR8030=y
BR2_PACKAGE_AR8030_FIRMWARE=y
# The baseband runs the Ascent air firmware, not the stock P1 one: the P1
# firmware (2026-03) uses an older MAC frame header and cannot link with
# Ascent ground units. The Ascent image runs on the P1 radio unchanged
# (see devices/ar9311_artosyn_artlynk-p1/README.md).
BR2_PACKAGE_AR8030_FIRMWARE_FETCH_SCRIPT="scripts/fetch-ascent-ar8030-firmware.py"
BR2_PACKAGE_AR8030_FIRMWARE_FETCH_DEPENDENCY="ascent-vendor-firmware artlynk-p1-vendor-firmware"
BR2_PACKAGE_ASCENT_VENDOR_FIRMWARE=y
BR2_PACKAGE_AR8030_PAIR_TOOL=y
# BR2_PACKAGE_AR8030_USB_LOADER is not set
BR2_PACKAGE_AR8030_TOOLS=y
BR2_PACKAGE_AR8030_TUNTAP=y
BR2_PACKAGE_AR8030_TRANSPORT_TX=y
# Video: waybeam's ar9311 backend (NT99235 V4L2 camera -> wave5 H.265 ->
# frame-shm://venc_frames, which ar8030-transport-tx sends over the link),
# pinned in package/waybeam/waybeam.mk.
BR2_PACKAGE_WAYBEAM=y
BR2_PACKAGE_WAYBEAM_BACKEND_AR9311=y
BR2_PACKAGE_WAYBEAM_JSON_CLI=y
# OSD: msposd's headless target reads MSP DisplayPort from the flight
# controller (UART /dev/ttyS1) and forwards it to the ground, which draws it.
# package/msposd maps ar9311 to it; P1 SoC temperature for -t is a patch in
# general/package/all-patches/msposd. Started by S99msposd, configured via
# /etc/default/msposd.
BR2_PACKAGE_MSPOSD=y
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_DROPBEAR_OPENIPC_DISABLE_REVERSEDNS=y
# Out-of-tree exFAT driver: does not build on 6.18, which has exFAT in-kernel.
# BR2_PACKAGE_EXFAT_OPENIPC is not set
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_JSONFILTER=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_MBEDTLS_OPENIPC=y
# BR2_PACKAGE_MAJESTIC is not set
# BR2_PACKAGE_MAJESTIC_FONTS is not set
# BR2_PACKAGE_MAJESTIC_WEBUI is not set
BR2_PACKAGE_VTUND_OPENIPC=y
BR2_PACKAGE_YAML_CLI=y
BR2_PACKAGE_MTD=y
BR2_PACKAGE_MTD_NANDWRITE=y
BR2_PACKAGE_MTD_FLASH_ERASE=y
BR2_PACKAGE_SOCAT=y
