# ar8030-transport-tx runtime configuration, sourced by
# /etc/init.d/S65ar8030-transport-tx. Overrides the package's own default
# file (package/ar8030-transport-tx/files/etc/default/ar8030-transport-tx)
# -- see that file for the full set of variables this can set.

# AR8030_TRANSPORT_TX_ENABLED=false

# -S 5602: forward waybeam's RTP timing sidecar (outgoing.sidecarPort,
# waybeam's own default 5602) to the ground, where ar8030-transport-rx serves
# it on 127.0.0.1:5602 and uses it for the encode-time part of the per-frame
# latency figures.
AR8030_TRANSPORT_TX_ARGS="-S 5602"

# GPIO7_3 (bank 7 at 0x11097000, bit 3): this board's ar8030_rst line --
# the vendor's own sys_config.ko pulsed it (fpv_edu405_gpio_init); here
# S65ar8030-transport-tx owns it instead, see hisilicon-opensdk's
# 0001-caddx-ascent-lite.patch for why it moved out of sys_config.
AR8030_RESET_GPIO_BANK=0x11097000
AR8030_RESET_GPIO_BIT=3

# gpio0: this board's physical bind button (idle=1, pressed=0, confirmed
# by hand on real hardware -- exported as an input by muxes.sh before
# ar8030-lifecycled ever starts). See ar8030-transport's README
# "ar8030-lifecycled: link supervisor + bind button".
# No --rf-temp-adc here: the Lite is stock board type CX472 (ar_ldyhs_sky
# project type 7, from the SoC LSADC channel 1 board-ID resistor, 896 mV),
# which has no RF-board thermistor -- only CX4861/CX4862 (type 5/8,
# separate RF board) read one, on AR8030 ADC channel 4. On the Lite that
# channel floats at ~230 mV.
# --batt-adc 0: supply voltage on AR8030 ADC channel 0, through a x16
# divider plus ~1.2 V -- the defaults of --batt-scale/--batt-offset-mv,
# measured with a lab PSU at 6/9/12 V (see ar8030-transport's
# common/ar8030_batt.h).
# --rf-path-b-off: this board has one antenna and one PA, but the chip
# comes up with RF path B transmitting and receiving too. Stock switches
# path B off at startup on the Lite (ar_ldyhs_sky fpv_bb_init():
# fpv_bb_set_rf_path_b(0) for project type 7); lifecycled does the same.
AR8030_LIFECYCLED_ARGS="--bind-gpio 0 --http-port 8899 --batt-adc 0 --rf-path-b-off"

# Flight logging (toggle with `flightlog enable|disable`, or edit here and
# reboot): S99air-telemetry (SoC temp/load, ar8030d, chip and transport-tx
# logs into syslog) plus, via /etc/default/syslogd, the 512 KiB syslog
# buffer and forwarding to the ground station's ar8030-flightlog. false
# gives back stock syslogd (64 KiB, local only) and no follower processes.
FLIGHTLOG_ENABLED=false
