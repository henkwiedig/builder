#!/bin/sh
# Starts the physical bind-button watcher (ar8030-bind-button.sh). S66, not
# folded into S65ar8030-transport-tx itself: unrelated lifecycle (this
# should keep running even across an S65 restart/reset, e.g. the one the
# button handler itself triggers on a successful pair) and it only needs
# gpio0 already exported, which S30customizer's muxes.sh guarantees by S66.
DAEMON=/usr/sbin/ar8030-bind-button.sh
PIDFILE=/var/run/ar8030-bind-button.pid

case "$1" in
	start)
		echo "Starting ar8030-bind-button..."
		start-stop-daemon -S -b -q -m -p "$PIDFILE" -x "$DAEMON"
		;;
	stop)
		echo "Stopping ar8030-bind-button..."
		start-stop-daemon -K -q -p "$PIDFILE"
		;;
	restart|reload)
		$0 stop
		sleep 1
		$0 start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
