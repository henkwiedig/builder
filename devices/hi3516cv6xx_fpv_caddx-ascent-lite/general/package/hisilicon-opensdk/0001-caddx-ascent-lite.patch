diff -ru a/kernel/sys_config/hi3516cv6xx/pin_mux.c b/sys_config/hi3516cv6xx/pin_mux.c
--- a/kernel/sys_config/hi3516cv6xx/pin_mux.c
+++ b/sys_config/hi3516cv6xx/pin_mux.c
@@ -293,8 +293,21 @@
     switch (vi_intf_type) {
         case VI_MIPI_RX_MODE:
             i2c_pin_mux(PIN_MUX_I2C_0);
-            i2c_pin_mux(PIN_MUX_I2C_1);
-            i2c_pin_mux(PIN_MUX_I2C_2);
+            /*
+             * caddx_ascent_lite: the real board profile leaves these two
+             * pins alone (the vendor firmware confirms this via
+             * disassembly of its own pin_mux()) -- iocfg2 0x90/0x94 (I2C1)
+             * is a multi-function pin shared with SENSOR0_HS/BT1120 VI_CLK
+             * on this SoC, and on this board's real PCB routing it is used
+             * for something other than I2C1/I2C2, so driving it into
+             * I2C1/I2C2 mode here was corrupting a MIPI-RX-adjacent signal
+             * just enough to break VENC's completion latch while leaving
+             * capture/ISP activity intact.
+             */
+            if (board_type != BOARD_CADDX_ASCENT_LITE) {
+                i2c_pin_mux(PIN_MUX_I2C_1);
+                i2c_pin_mux(PIN_MUX_I2C_2);
+            }
             mipi_rx_pin_mux(MIPI_RX_0);
             break;
         case VI_CMOS_BT1120_MODE:
@@ -352,6 +365,39 @@
 #endif
 }
 
+/*
+ * caddx_ascent_lite board only: init the two status LEDs (GPIO7_7 = LED_R,
+ * GPIO1_0 = LED_G). Decoded from the vendor's real sys_config.ko via manual
+ * disassembly (the vendor's own function is named fpv_edu405_gpio_init --
+ * renamed here to match our own board naming).
+ *
+ * The vendor function also pulses the AR8030 companion chip's reset line
+ * (GPIO7_3) -- deliberately left out here. On the vendor firmware
+ * sys_config.ko loads once, before anything talks to the radio; here it is
+ * part of the camera stack (load_hisilicon / load-cv610-online), which runs
+ * after the AR8030 bring-up and can be unloaded and reloaded at runtime. A
+ * reset from here yanked the chip out from under a running ar8030d --
+ * killing the link on every camera-stack reload, and at boot making the
+ * chip only appear once S95waybeam ran, racing ar8030d's first open. The
+ * AR8030 reset is owned by S65ar8030-transport-tx now, which pulses it
+ * right before loading artosyn_drv.
+ */
+static void caddx_ascent_lite_gpio_init(void)
+{
+    void *gpio_base = sys_config_get_reg_gpio();
+    unsigned int reg;
+
+    /* GPIO7_7: LED_R, output, init low */
+    reg = sys_readl(gpio_base, 0x7400);
+    sys_writel(gpio_base, 0x7400, reg | 0x80);
+    sys_writel(gpio_base, 0x7200, 0x00);
+
+    /* GPIO1_0: LED_G, output, init high */
+    reg = sys_readl(gpio_base, 0x1400);
+    sys_writel(gpio_base, 0x1400, reg | 0x01);
+    sys_writel(gpio_base, 0x1004, 0x01);
+}
+
 void pin_mux(void)
 {
     int vi_intf_type = sys_config_get_vi_intf_type();
@@ -360,7 +406,12 @@
     bool ir_auto_en = sys_config_get_ir_auto();
 
     sensor_pin_mux(PIN_MUX_SENSOR_0, board_type);
-    sensor_pin_mux(PIN_MUX_SENSOR_1, board_type);
+    /* caddx_ascent_lite is single-sensor; its sensor1 pins are reused for
+     * something else on the real board, same reasoning as the I2C1/I2C2
+     * skip in vi_pin_mux() below. */
+    if (board_type != BOARD_CADDX_ASCENT_LITE) {
+        sensor_pin_mux(PIN_MUX_SENSOR_1, board_type);
+    }
     if (ir_auto_en == 1) {
         ir_auto_pin_mux();
     }
@@ -371,6 +422,18 @@
 
     vi_pin_mux(vi_intf_type, board_type);
 
+    if (board_type == BOARD_CADDX_ASCENT_LITE) {
+        /* Matches the vendor's real pin_mux(): caddx_ascent_lite takes a
+         * separate exit path here entirely, skipping i2s0/uart2/
+         * amp_unmute_pin_mux (not wired on this board) and instead
+         * initializing the status LEDs (the vendor also resets the
+         * AR8030 here -- see caddx_ascent_lite_gpio_init()). */
+        caddx_ascent_lite_gpio_init();
+        sys_writel(reg_misc_base, 0x170, 0x0);  /* VGS & GZIP */
+        sys_writel(reg_misc_base, 0x174, 0x0);  /* ddrt MUX */
+        return;
+    }
+
     /* audio */
 #if I2S0_EN
     i2s0_pin_mux(BOARD_SCK);
