# openipc/br-ext-chip-hisilicon/board/hi3516cv6xx/hi3516cv6xx.generic.config
# (the shared config for every hi3516cv6xx board) is built for the common
# case: boot from SPI-NOR (CONFIG_MTD_SPI_NOR=y, CONFIG_SPI_BSP_SFC=y). This
# device is NAND-only (no NOR chip populated) and its rootfs is UBI/UBIFS
# (see BR2_TARGET_ROOTFS_UBI above) -- without this fragment the kernel
# never registers any MTD device at all: the DTS "nand@0 { compatible =
# "jedec,spi-nand"; }" node has nothing to bind to, u-boot's `ubi.mtd=N`
# bootarg refers to a partition table that was never created, and the boot
# hangs at "VFS: Cannot open root device "ubi0:ubifs" ... error -19" with
# no NAND/UBI driver messages anywhere earlier in dmesg -- only bsp-sfc
# (the SPI-NOR controller, harmlessly failing to find a chip that isn't
# there) shows up. Confirmed against the vendor's own reference
# hi3516cv610_nand_mini_defconfig (openipc/linux
# arch/arm/configs/hi3516cv610_nand_mini_defconfig), which sets exactly
# this set of symbols on top of the same base as hi3516cv610_defconfig.
#
# CONFIG_MTD_SPI_NAND_BSP depends on CONFIG_MTD_RAW_NAND (despite the name
# -- it's the vendor's SPI-NAND enable switch, gating fmc100 below).
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_SPI_NAND_BSP=y
# The actual controller driver (Hisilicon Flash Memory Controller v100),
# depends on MFD_BSP_FMC (already =y in the shared config) &&
# MTD_SPI_NAND_BSP above.
CONFIG_MTD_SPI_NAND_FMC100=y
# Generic SPI-NAND MTD framework (upstream drivers/mtd/nand/spi/).
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y
# This device's rootfs.ubifs is built with runtime lzo compression
# (BR2_TARGET_ROOTFS_UBIFS_RT_LZO is Buildroot's default and nothing in
# this device's defconfig overrides it -- check
# `grep UBIFS_RT hi3516cv6xx_fpv_caddx-ascent-lite_defconfig` if that ever
# changes). Without CONFIG_UBIFS_FS_LZO, mount fails with "unknown
# compression type" instead of the CONFIG_MTD_UBI "error -19" this fragment
# already fixes -- same trim commit dropped both.
CONFIG_UBIFS_FS_LZO=y
