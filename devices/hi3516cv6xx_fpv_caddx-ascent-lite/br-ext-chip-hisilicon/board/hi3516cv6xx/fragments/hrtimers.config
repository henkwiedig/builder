# openipc/br-ext-chip-hisilicon/board/hi3516cv6xx/hi3516cv6xx.generic.config
# ships with "# CONFIG_HIGH_RES_TIMERS is not set" and CONFIG_HZ=100, so every
# usleep()/nanosleep() on this board rounds up to the next 10 ms tick
# (/proc/timer_list: resolution 10000000 nsecs; 100 x usleep(1000) took 1.8 s).
# For a video link that is 0-10 ms of latency wherever something sleeps to
# poll: waybeam's CV610 encoder loop picked frames up on a 100.000 Hz grid
# against a 100.126 Hz sensor, a 7.7 s sawtooth of up to 10 ms (measured
# 2026-09-30). The ARM architected timer is there to drive one-shot high
# resolution events; only the option was off.
#
# HZ stays at 100: with high resolution timers, sleeps and poll/select
# timeouts no longer depend on the tick, and a slower tick is less overhead
# on this single small core.
CONFIG_HIGH_RES_TIMERS=y
