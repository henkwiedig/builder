# Restores USB gadget/configfs support that firmware commit 9dfe5595f
# ("hi3516cv6xx: add the lite variant, and trim the shared kernel to fit
# it", #2447, 2026-09-19) dropped from the shared hi3516cv6xx.generic.config
# along with the NAND/UBI stack (see nand.config's own comment -- same
# commit, same "trim for the common SPI-NOR board" rationale, same
# collateral damage for this device). That commit flipped the DWC3
# controller from dual-role to host-only and removed CONFIG_USB_GADGET
# entirely, so /usr/bin/usb-gadget's `mkdir /sys/kernel/config/usb_gadget/`
# fails with "Operation not permitted" -- CONFIGFS_FS is still on, but with
# USB_GADGET off the gadget core never registers the usb_gadget configfs
# subsystem for anything to mkdir into.
#
# DWC3 mode is a Kconfig choice (host / gadget / dual-role) -- both lines
# needed, not just the positive one, or syncconfig may keep HOST depending
# on fragment merge order.
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_HOST is not set

CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VBUS_DRAW=2
CONFIG_USB_GADGET_STORAGE_NUM_BUFFERS=2
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_F_UAC1=y
CONFIG_USB_F_UVC=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_UAC1=y
CONFIG_USB_CONFIGFS_F_UVC=y

# f_uac1.c ("This function is an ALSA sound card following USB Audio Class
# Spec 1.0") backs CONFIG_USB_F_UAC1 with a real ALSA card -- the same
# trim commit also dropped CONFIG_SOUND/CONFIG_SND* wholesale, so without
# this the gadget mkdir would work but the UAC1 function would fail to
# come up. Core symbols only (not CONFIG_SND_USB, the *host*-side USB
# audio class driver -- unrelated to this gadget function -- or
# CONFIG_SND_SPI, a hardware codec driver this board has no chip for;
# both were also =y before the trim but neither is needed here).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_SUPPORT_OLD_API=y
