# Restores USB gadget/configfs support that firmware commit 9dfe5595f
# ("hi3516cv6xx: add the lite variant, and trim the shared kernel to fit
# it", #2447, 2026-09-19) dropped from the shared hi3516cv6xx.generic.config
# along with the NAND/UBI stack (see nand.config's own comment -- same
# commit, same "trim for the common SPI-NOR board" rationale, same
# collateral damage for this device). That commit flipped the DWC3
# controller from dual-role to host-only and removed CONFIG_USB_GADGET
# entirely, so /usr/bin/usb-gadget's `mkdir /sys/kernel/config/usb_gadget/`
# fails with "Operation not permitted" -- CONFIGFS_FS is still on, but with
# USB_GADGET off the gadget core never registers the usb_gadget configfs
# subsystem for anything to mkdir into.
#
# DWC3 mode is a Kconfig choice (host / gadget / dual-role) -- both lines
# needed, not just the positive one, or syncconfig may keep HOST depending
# on fragment merge order.
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_HOST is not set

CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VBUS_DRAW=2
CONFIG_USB_GADGET_STORAGE_NUM_BUFFERS=2
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_F_UAC1=y
CONFIG_USB_F_UVC=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_UAC1=y
CONFIG_USB_CONFIGFS_F_UVC=y

# f_uac1.c ("This function is an ALSA sound card following USB Audio Class
# Spec 1.0") backs CONFIG_USB_F_UAC1 with a real ALSA card -- the same
# trim commit also dropped CONFIG_SOUND/CONFIG_SND* wholesale, so without
# this the gadget mkdir would work but the UAC1 function would fail to
# come up. Core symbols only (not CONFIG_SND_USB, the *host*-side USB
# audio class driver -- unrelated to this gadget function -- or
# CONFIG_SND_SPI, a hardware codec driver this board has no chip for;
# both were also =y before the trim but neither is needed here).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_SUPPORT_OLD_API=y

# CONFIG_USB_CONFIGFS_F_UVC above `depends on VIDEO_V4L2` && `depends on
# VIDEO_DEV` (drivers/usb/gadget/Kconfig) -- the same trim commit also
# dropped CONFIG_MEDIA_SUPPORT/CONFIG_VIDEO_V4L2/videobuf2 wholesale, so
# without this block that CONFIGFS_F_UVC=y line above is silently reset to
# off by kernel syncconfig regardless (unmet "depends on"), independent of
# whatever's actually breaking hisilicon-opensdk's own load-cv610-online
# `open_uvc.ko` ("unknown symbol in module") -- that vendor module bridges
# the ISP/VPSS pipeline to a UVC gadget the same standard way (a V4L2
# capture device feeding the USB Video Class function), so it almost
# certainly needs this same V4L2/videobuf2 chain to resolve its own
# symbols. Confirm the exact missing symbol with `dmesg | tail` right
# after the failed insmod if this doesn't clear it.
#
# Deliberately NOT restoring the DVB/analog-TV/radio/SDR/tuner half of
# what the trim commit removed (CONFIG_DVB_CORE, CONFIG_MEDIA_TUNER,
# CONFIG_MEDIA_USB_SUPPORT/CONFIG_USB_VIDEO_CLASS -- the mainline UVC
# *host* driver, for consuming an external webcam, not relevant to being
# one) -- none of that has anything to do with a camera SoC's own ISP
# output, and unlike hi3516cv6xx_lite (the "5120 KB rootfs slot" this trim
# commit was actually sized for), this device is the "fpv" variant on
# 16MiB NAND partitions, so the flash pressure that motivated the original
# trim doesn't apply here anyway -- no need to cut a corner just to match
# it.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_VIDEO_V4L2_I2C=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_V4L2=y
CONFIG_VIDEOBUF2_MEMOPS=y
CONFIG_VIDEOBUF2_VMALLOC=y
CONFIG_MEDIA_ATTACH=y
