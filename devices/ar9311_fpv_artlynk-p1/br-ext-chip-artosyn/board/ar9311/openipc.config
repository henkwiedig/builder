# OpenIPC additions on top of ml-kernel's ml_defconfig (arm64 defconfig +
# artosyn + trim + the betafpv-vr04-air fragments). trim.config drops most of
# these to keep MissingLynk's own image small.

# Shared OpenIPC /init: squashfs/UBIFS root + overlay on rootfs_data.
CONFIG_OVERLAY_FS=y

# /tmp, /run, /dev/shm are mounted with mode=/size= options; without TMPFS
# the ramfs-backed fallback rejects them.
CONFIG_TMPFS=y

# OpenIPC's S38mdev registers mdev as the hotplug helper; without it device
# nodes that appear after boot (e.g. /dev/artosyn_sdio once the AR8030
# re-enumerates) are never created.
CONFIG_UEVENT_HELPER=y

# ar8030-tun (BR2_PACKAGE_AR8030_TUNTAP).
CONFIG_TUN=y

# /etc/init.d/S65ar8030-transport-tx drives the AR8030 reset (GPIO23) and
# ar8030-lifecycled reads the bind button (GPIO42) through gpiolib sysfs.
# On 6.18 the (deprecated) sysfs interface is only selectable with EXPERT,
# and the global-number export/unexport the scripts use is GPIO_SYSFS_LEGACY.
CONFIG_GPIOLIB=y
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_SYSFS_LEGACY=y

# usb-gadget composes an RNDIS function (Windows binds it driverless);
# ml-kernel's trim.config turns it back off after artosyn.config enables it.
CONFIG_USB_CONFIGFS_RNDIS=y

# RAM boot without flash: initrd from the USB loader, or NFS root over the
# USB RNDIS gadget.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# The ml-kernel air DTS binds the bind button (GPIO42) to gpio-keys-polled;
# ar8030-lifecycled reads it via gpiolib sysfs instead (--bind-gpio), so
# leave that node unbound.
# CONFIG_KEYBOARD_GPIO_POLLED is not set
