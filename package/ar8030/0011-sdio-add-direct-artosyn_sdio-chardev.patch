+                     * this kernel workqueue thread and a chardev reader call
+                     * artosyn_read() on the same dev concurrently, racing on
+                     * its single reading/read_offset/read_valid_size state.
+                     * Confirmed on real hardware: with ar8030d built for
+                     * INTF_TYPE_SDIO (nothing ever opens /dev/ar_mdev0, so
+                     * this workqueue's own output was always going nowhere in
+                     * that mode anyway), this raced constantly --
+                     * "artosyn_read: busy" (-EBUSY, dev->reading already set
+                     * by the other caller) interleaved with immediate
+                     * "dev->read_valid_size == dev->read_offset" (-EAGAIN,
+                     * the other caller already drained it first) on every
+                     * poll()/read() cycle from userspace. read_offset/
+                     * read_valid_size bookkeeping above stays unconditional
+                     * (the chardev's own artosyn_sdio_read_condition() poll
+                     * check depends on it) -- only the redundant second
+                     * consumer is skipped. */
+                    if (dev->handle && !atomic_read(&sdio_chardev_open_count)) {
                         oal_queue_work(dev->handle, dev->rx_workqueue);
                     }
                     // wake_up_interruptible_all(&dev->rx_q);
@@ -1450,6 +1648,24 @@
 
     AR_DBG(DM_SDIO, DL_MSG, "artosyn sdio device added\n");
 
+    /* Only expose /dev/artosyn_sdio once this probe is for the real RTOS
