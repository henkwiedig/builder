 static volatile uint8_t removed = 1;
 static volatile uint32_t opened = 0;
 
+/* /dev/artosyn_sdio -- a direct, unbuffered-by-anything-else character
+ * device sitting straight on top of this file's own artosyn_sdio_write()/
+ * artosyn_read(), for a userspace daemon build (DEV_8030_SDIO, see
+ * daemon/dev8030/sdio8030/sdio_dev.c) to open/poll/read/write against
+ * instead of going through the ar_mdev<N>/oal_mdev.c chardev (DRV mode).
+ *
+ * Not an alternative bus transport -- it's the exact same probed device
+ * and the exact same sdio_memcpy_to/fromio() calls either way. The
+ * difference is what sits between userspace and those calls: oal_mdev.c's
+ * send() path allocates a fresh skb per write and queues it through
+ * oal_send_msg_req() (built for multiplexing up to 8 ar_mdev instances
+ * over one physical channel, with its own retry/backoff for a full
+ * queue); this path calls artosyn_sdio_write()/artosyn_read() directly; a
+ * single physical device, no multiplexing to do. Confirmed on real
+ * hardware: DRV-mode ar8030-transport-tx plateaued around 5-7Mbps
+ * regardless of link bandwidth/MCS; the same tool unmodified against
+ * this device reached ~18Mbps.
+ *
+ * One instance only (this driver only ever probes one physical chip), so
+ * a single file-scope pointer -- set in sdio_artosyn_probe(), cleared in
+ * sdio_artosyn_remove() -- is enough to find it; misc_register() means no
+ * major/class management to duplicate from oal_mdev.c for what is a much
+ * simpler device. Registered only once the chip has left ROM/firmware-
+ * download mode (mode == OAL_CARD_MODE_RPC in the probe below) -- opening
+ * this mid-firmware-push would just race artosyn_sdio_write()'s own
+ * rom_mode bring-up path, which nothing needs to do since the daemon
+ * isn't started until after that completes (see S60ar8030's own settle
+ * sleep).
+ *
+ * Status: implemented and builds/loads cleanly, but NOT yet confirmed
+ * working end-to-end -- see README.md's "SDIO chardev: implemented, not
+ * yet proven" section. Bring-up testing kept hitting an intermittent
+ * firmware-download failure that turned out to be present even with
+ * these changes fully reverted back to pristine upstream source, so it
+ * is very unlikely to be caused by this code, but it blocked ever
+ * reaching the point of actually opening this device under load. */
+static struct artosyn_sdio_device *g_sdio_chardev;
+static struct miscdevice sdio_chardev_misc;
+static bool sdio_chardev_registered;
+
+/* Whether some userspace daemon actually has /dev/artosyn_sdio open right
+ * now -- NOT the same thing as sdio_chardev_registered, which just means
+ * the device node exists (true from probe() onward regardless of which -i
+ * mode the daemon was actually started with). The RX-workqueue-skip guard
+ * below needs THIS, not mere registration: a DRV-mode daemon never opens
+ * this node at all, so gating on registered-but-not-necessarily-open used
+ * to disable oal_mdev.c's only RX feed permanently on every boot, breaking
+ * plain DRV mode too (confirmed live: total_rx_pkts stuck at 0 forever,
+ * even with nothing ever touching /dev/artosyn_sdio). atomic_t since
+ * open()/release() aren't serialized against the IRQ-handler/reg_check
+ * paths that read it. */
+static atomic_t sdio_chardev_open_count = ATOMIC_INIT(0);
+
+struct sdio_chardev_priv {
+    uint8_t *bounce; /* SDIO_TRANS_MAX_SZIE, allocated once per open() so
+                       * read()/write() never kmalloc per call -- unlike
+                       * ar_chardev_write()'s per-write kmalloc, this is
+                       * one allocation for the fd's whole lifetime. */
+};
+
+static int sdio_chardev_open(struct inode *inode, struct file *filp)
+{
+    struct sdio_chardev_priv *priv;
+
+    if (!g_sdio_chardev)
+        return -ENODEV;
+
+    priv = kzalloc(sizeof(*priv), GFP_KERNEL);
+    if (!priv)
+        return -ENOMEM;
+
+    priv->bounce = kmalloc(SDIO_TRANS_MAX_SZIE, GFP_KERNEL);
+    if (!priv->bounce) {
+        kfree(priv);
+        return -ENOMEM;
+    }
+
+    filp->private_data = priv;
+    atomic_inc(&sdio_chardev_open_count);
+    return 0;
+}
+
+static int sdio_chardev_release(struct inode *inode, struct file *filp)
+{
+    struct sdio_chardev_priv *priv = filp->private_data;
+
+    atomic_dec(&sdio_chardev_open_count);
+    if (priv) {
+        kfree(priv->bounce);
+        kfree(priv);
+    }
+    return 0;
+}
+
+static ssize_t sdio_chardev_read(struct file *filp, char __user *buf, size_t count, loff_t *f_pos)
+{
+    struct sdio_chardev_priv *priv = filp->private_data;
+    ssize_t ret;
+
+    if (!g_sdio_chardev)
+        return -ENODEV;
+    if (count > SDIO_TRANS_MAX_SZIE)
+        count = SDIO_TRANS_MAX_SZIE;
+
+    ret = artosyn_read(g_sdio_chardev, priv->bounce, count);
+    if (ret <= 0)
+        return ret;
+
+    if (copy_to_user(buf, priv->bounce, ret))
+        return -EFAULT;
+
+    return ret;
+}
+
+static ssize_t sdio_chardev_write(struct file *filp, const char __user *buf, size_t count, loff_t *f_pos)
+{
+    struct sdio_chardev_priv *priv = filp->private_data;
+    ssize_t ret;
+
+    if (!g_sdio_chardev)
+        return -ENODEV;
+    if (count > SDIO_TRANS_MAX_SZIE)
+        count = SDIO_TRANS_MAX_SZIE;
+
+    if (copy_from_user(priv->bounce, buf, count))
+        return -EFAULT;
+
+    ret = artosyn_sdio_write(g_sdio_chardev, priv->bounce, count, false);
+    return ret;
+}
+
+static __poll_t sdio_chardev_poll(struct file *filp, poll_table *wait)
+{
+    __poll_t mask = 0;
+
+    if (!g_sdio_chardev)
+        return POLLERR;
+
+    /* No dedicated poll waitqueue in this file -- dev->tx_q is the
+     * closest existing one and is already woken on every register-check
+     * pass (see the WORKAROUND_FOR_INTERRUPT_LOST_ISSUE paths in
+     * artosyn_sdio_write()/artosyn_read()), which is close enough to
+     * "check again soon" for poll() to notice new data promptly without
+     * needing a new wait source. */
+    poll_wait(filp, &g_sdio_chardev->tx_q, wait);
+
+    if (artosyn_sdio_read_condition(g_sdio_chardev))
+        mask |= POLLIN | POLLRDNORM;
+    if (artosyn_sdio_write_condition(g_sdio_chardev))
+        mask |= POLLOUT | POLLWRNORM;
+
+    return mask;
+}
+
+static const struct file_operations sdio_chardev_fops = {
+    .owner = THIS_MODULE,
+    .open = sdio_chardev_open,
+    .release = sdio_chardev_release,
+    .read = sdio_chardev_read,
+    .write = sdio_chardev_write,
+    .poll = sdio_chardev_poll,
+};
+
