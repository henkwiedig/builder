The AR8030 presents three different SDIO identities depending on boot
stage, not two:

  4152:8030  ROM bootloader, waiting for a firmware push (OAL_CARD_MODE_FW_DNLD)
  1d6b:8030  RTOS running, host-driver transport                  (OAL_CARD_MODE_RPC)
  4152:8031  RTOS running, host-driver transport -- what this chip
             actually re-enumerates as after a successful firmware
             push on this board (confirmed live: mmc0's re-enumerated
             function reports modalias sdio:cFFv4152d8031)

Upstream's device table and sdio_artosyn_probe() only know about the
first two. Without this, the chip reboots into real firmware and
re-enumerates correctly at the SDIO core level (mmc0: card removed /
new high speed SDIO card), but sdio_artosyn_probe() never gets called
a second time -- no matching struct sdio_device_id -- so oal_add_card()
is never reached in RPC mode and /dev/ar_mdev0 never appears.

diff --git a/driver/linux/bus/sdio.c b/driver/linux/bus/sdio.c
--- a/driver/linux/bus/sdio.c
+++ b/driver/linux/bus/sdio.c
@@ -52,6 +52,11 @@
 #define ARTO_RTOS_PID           (0x8030)
 #define ARTO_RTOS_NAME          "Artosyn in HS Mode"
 
+/* Same RTOS/host-driver transport as ARTO_RTOS_VID/PID above, just the
+ * identity this board's chip actually re-enumerates as post-boot. */
+#define ARTO_RTOS_ALT_VID       (0x4152)
+#define ARTO_RTOS_ALT_PID       (0x8031)
+
 /** The number of times to try when polling for status bits */
 #define MAX_POLL_TRIES            10
 
@@ -140,6 +145,7 @@
 static const struct sdio_device_id sdio_artosyn_ids[] = {
     { SDIO_DEVICE(ARTO_ROMCODE_VID, ARTO_ROMCODE_PID)},
     { SDIO_DEVICE(ARTO_RTOS_VID,    ARTO_RTOS_PID)   },
+    { SDIO_DEVICE(ARTO_RTOS_ALT_VID, ARTO_RTOS_ALT_PID)},
     { /* end: all zeroes */                },
 };
 
@@ -1416,7 +1422,8 @@
         dev->rom_mode = true;
         mode = OAL_CARD_MODE_FW_DNLD;
     }
-    else if ((func->vendor == ARTO_RTOS_VID) && (func->device == ARTO_RTOS_PID)) {
+    else if (((func->vendor == ARTO_RTOS_VID) && (func->device == ARTO_RTOS_PID)) ||
+             ((func->vendor == ARTO_RTOS_ALT_VID) && (func->device == ARTO_RTOS_ALT_PID))) {
         mode = OAL_CARD_MODE_RPC;
     }
     else {
