config BR2_PACKAGE_AR8030
	bool "ar8030"
	depends on BR2_LINUX_KERNEL
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  Artosyn AR8030 baseband host support — the vendor "yz_host_drv"
	  SDK (kernel driver + userspace RPC daemon + client library).

	  Always installed:
	  - artosyn_drv.ko: out-of-tree host driver. Binds the AR8030 over
	    USB (4152:8030) and/or SDIO, pushes the baseband firmware into
	    the chip at probe time via request_firmware(), and exposes
	    /dev/ar_mdev<N> char devices, a /proc interface and a network
	    interface.
	  - ar8030d: the SDK "daemon". It owns the char device and serves
	    the RPC that applications talk to (TCP on 127.0.0.1 plus a unix
	    socket). Nothing else can reach the baseband while it is down,
	    so it must be started before any client.
	  - libar8030_client.so: the bb_* client API. Headers are installed
	    into <staging>/usr/include/ar8030.

	  Upstream calls these "daemon", "app", "ota" and "cmd_dbg"; they
	  are installed with an ar8030 prefix here so they can share
	  /usr/bin with the rest of the rootfs.

	  The driver needs a Linux 4.x or newer kernel — its compat shims
	  bottom out around 3.10 and the netdev/USB code is written against
	  4.x APIs. It will not build against the 3.0.8/3.4 vendor BSP
	  kernels used by the older HiSilicon SoCs.

	  The SDK is only published as source on a vendor Gitea instance
	  (no releases, no tags), so the package is pinned to a commit.

	  https://git.topxgun.com/czdu/yz_host_drv

comment "ar8030 needs a toolchain w/ C++, threads"
	depends on BR2_LINUX_KERNEL
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS

if BR2_PACKAGE_AR8030

choice
	prompt "host bus"
	default BR2_PACKAGE_AR8030_BUS_BOTH
	help
	  Which transport(s) the kernel driver is compiled with. Each one
	  needs the matching subsystem in the kernel config: USB needs
	  CONFIG_USB plus a host controller, SDIO needs CONFIG_MMC plus an
	  SDIO-capable host controller driver.

config BR2_PACKAGE_AR8030_BUS_BOTH
	bool "USB and SDIO"

config BR2_PACKAGE_AR8030_BUS_USB_ONLY
	bool "USB only"

config BR2_PACKAGE_AR8030_BUS_SDIO_ONLY
	bool "SDIO only"

endchoice

config BR2_PACKAGE_AR8030_FIRMWARE
	bool "install the demo baseband firmware"
	default y
	help
	  Installs the SDK's demo baseband image and its config to
	  /lib/firmware/ar8030 (bb_demo.img, bb_config.json, and the
	  usr_{ap,dev,master,slave}.json role overlays), so the driver can
	  boot the chip with fw_name=/cfg_name= module parameters.

	  Costs about 340 KB uncompressed. Turn it off if the AR8030 on
	  your board boots from its own flash, or if you ship a different
	  image out of an overlay.

config BR2_PACKAGE_AR8030_INIT
	bool "install /etc/init.d/S60ar8030"
	default y
	help
	  Boot script that loads artosyn_drv (with fw_name/cfg_name when
	  /lib/firmware/ar8030 is populated) and starts ar8030d from a
	  writable working directory — the daemon puts its log directory
	  and its unix socket in $PWD, which does not work from a
	  read-only rootfs.

config BR2_PACKAGE_AR8030_PAIR_TOOL
	bool "bb_pair binding tool"
	default y
	help
	  Installs bb_pair as /usr/bin/ar8030-pair: the vendor's
	  pair/bind utility. Talks to ar8030d over the local RPC socket,
	  so the daemon has to be running.

config BR2_PACKAGE_AR8030_USB_LOADER
	bool "USB rom-code firmware loader"
	default n
	help
	  Installs ar8030_usb_test_tool as /usr/bin/ar8030-usb-loader,
	  the userspace path for pushing a baseband image into an AR8030
	  sitting in USB rom-code mode (VID:PID 4152:8030), used together
	  with the SDK's mdev "autoload" hotplug flow.

	  Redundant when the kernel driver does the download itself, and
	  it statically links the SDK's bundled libusb, so it is off by
	  default.

config BR2_PACKAGE_AR8030_TOOLS
	bool "extra debug tools"
	default n
	help
	  Installs the SDK's demo and debug programs:
	    ar8030-cmd-dbg      interactive command console (cmd_dbg)
	    ar8030-ota          OTA image upgrade tool (ota)
	    ar8030-test         the generic API demo (app)
	    ar8030-netdev-demo  network-interface configuration demo

	  These are vendor test programs, not production tooling.

endif
