#!/bin/sh
#
# Artosyn AR8030 baseband: load the host driver, then start the RPC daemon
# that every client (ar8030-pair, majestic, anything linking
# libar8030_client) talks to.
#

MODULE="artosyn_drv"
DAEMON="/usr/bin/ar8030d"
PIDFILE="/var/run/ar8030d.pid"

# The daemon creates its "daemon_log" directory and its unix socket relative
# to $PWD, and the rootfs is read-only, so give it a writable cwd.
RUNDIR="/tmp/ar8030"

# Baseband image + config pushed into the chip by the driver at probe time,
# as paths under /lib/firmware. Left out of the insmod line when absent, in
# which case the AR8030 is expected to boot from its own flash.
FW_NAME="ar8030/ar8030.img"
CFG_NAME="ar8030/ar8030.json"

# Interface the daemon should use: 0=usb 1=sdio 2=uart 3=drv. The package
# builds the daemon with the driver backend only (USING_8030DRV=ON, see
# ar8030.mk) -- that's daemon/main.c's INTF_TYPE_DRV, which opens
# /dev/ar_mdev<N> (created by the kernel driver below). INTF_TYPE_SDIO
# (1) is a *different*, mutually exclusive architecture where the daemon
# opens /dev/artosyn_sdio directly and does all SDIO bus handling itself
# in userspace -- not what this daemon build supports; passing 1 here
# starts the daemon fine but it never finds a device.
INTF=3

start() {
	echo "Starting ar8030..."

	echo -n "/lib/firmware" > /sys/module/firmware_class/parameters/path

	args=""
	[ -f "/lib/firmware/$FW_NAME" ] && args="$args fw_name=$FW_NAME"
	[ -f "/lib/firmware/$CFG_NAME" ] && args="$args cfg_name=$CFG_NAME"

	if ! modprobe $MODULE $args; then
		echo "ar8030: failed to load $MODULE"
		exit 1
	fi

	# modprobe only blocks through the chip's ROM-mode firmware push and its
	# self-reboot/re-enumeration as a fresh SDIO function -- it does not wait
	# for the chip to finish settling into RPC mode afterward. Starting the
	# daemon immediately races that settle time: the very first RX interrupt
	# on the new link can arrive before the daemon's workqueues are ready to
	# drain it, and the driver's read_offset/read_valid_size bookkeeping
	# never recovers from that ("bytes for read lost" in dmesg), leaving
	# every later bb_dev_getlist() call from clients like ar8030-pair seeing
	# no device at all. The vendor's own boot script has the equivalent gap
	# here too (sleep 3 between insmod'ing its own SDIO module and starting
	# its daemon); confirmed live at real boot time that 3s is enough margin
	# now that the SDIO IRQ handler's size-decode bug is fixed (see 0004-*.patch
	# -- that bug, not this settle time, was the actual cause of the earlier
	# "bytes for read lost"/no-device failures this sleep couldn't fully paper
	# over on its own).
	sleep 3

	mkdir -p "$RUNDIR"
	cd "$RUNDIR" || exit 1
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- -i $INTF

	autoreconnect
}

# Bring the RF link back up after a normal reboot without needing
# ar8030-pair run by hand again. PRJ_CMD_EVENT_PAIR (see
# 0007-bb_pair-auto-reconnect-on-boot.patch) is the only mechanism that
# moves the chip from BB_LINK_STATE_IDLE to CONNECT -- a persisted
# candidate MAC in $CFG_NAME only tells the chip who it's *allowed* to
# link with, it does not make the chip attempt the link on its own at
# boot, so without this every reboot would otherwise need a manual
# re-pair (confirmed on real hardware).
#
# Gated on the "$CFG_NAME.paired" marker, written only by a successful
# `ar8030-pair` run: a unit that has never been paired keeps its
# factory-default candidate list, which on the AP side is empty and
# means "accept anyone" (see the shipped ar8030.json's own "slot match
# all" help text) -- looping this unconditionally would have a
# never-paired unit silently re-broadcast PRJ_CMD_EVENT_PAIR at whatever
# AR8030 happens to be in range. Runs detached so a peer that isn't
# powered on yet doesn't delay boot (majestic/streaming in particular);
# --skip-if-connected keeps it from re-triggering pairing against a link
# that's already up once it succeeds.
# restart/reload/reset all funnel through start() again -- guard against
# piling up duplicate loops (stop() below kills whatever this pidfile
# points at, but only if it still exists).
AUTORECONNECT_PIDFILE="$RUNDIR/autoreconnect.pid"

# Widen the video data channel's TX bandwidth past the narrow gear it
# reconnects at by default. On real hardware this stayed pinned at 5MHz
# (BB_BW_5M) indefinitely regardless of how good the link actually was --
# MCS adapted up to its ceiling fine on its own, bandwidth never did.
# BB_CFG_SLOT_RX_MCS's bw_auto policy (the mechanism that would let the
# chip do this by itself as MCS improves) turned out to be unimplemented
# in this daemon build ("req 5 not found" -- see ar8030-transport's own
# README, "Bandwidth: the real bottleneck", for the full investigation);
# ar8030.json's own subchan.main_bw already permits up to 20MHz, this
# just asks for it directly via BB_SET_BANDWIDTH (ar8030-linkctl, from
# the ar8030-transport-tx package -- optional here, hence the -x guard,
# same as ar8030-pair above). Not persistent at the chip level, so this
# has to re-run every time the link reaches CONNECT, same as pairing
# itself does.
apply_link_tuning() {
	[ -x /usr/bin/ar8030-linkctl ] || return 0
	ar8030-linkctl bandwidth 20 -d tx -w 30 >>"$RUNDIR/autoreconnect.log" 2>&1
}

autoreconnect() {
	[ -x /usr/bin/ar8030-pair ] || return 0
	[ -f "/lib/firmware/$CFG_NAME.paired" ] || return 0
	(
		while ! ar8030-pair --no-persist --skip-if-connected -c "/lib/firmware/$CFG_NAME" \
				>>"$RUNDIR/autoreconnect.log" 2>&1; do
			sleep 10
		done
		apply_link_tuning
	) &
	echo $! > "$AUTORECONNECT_PIDFILE"
}

stop() {
	echo "Stopping ar8030..."
	start-stop-daemon -K -q -p "$PIDFILE"
	rm -f "$PIDFILE"
	[ -f "$AUTORECONNECT_PIDFILE" ] && kill "$(cat "$AUTORECONNECT_PIDFILE")" 2>/dev/null
	rm -f "$AUTORECONNECT_PIDFILE"
	rmmod $MODULE 2>/dev/null
}

# Re-pulses the AR8030's own hardware reset line (GPIO7_3, "ar8030_rst" on
# the caddx_ascent_lite board) to force the chip to reboot and re-upload
# fw_name/cfg_name via a fresh probe, without power-cycling the whole board.
# This is the same reset caddx_ascent_lite_gpio_init() does once at kernel
# boot (see hisilicon-opensdk's 0001-caddx-ascent-lite.patch) -- decoded
# from the vendor's sys_config.ko: GPIO bank 7 is a PL061 controller at
# physical 0x11097000 (see gpio_chip7 in hi3516cv610.dtsi), and the PL061
# masked-write scheme means a data write at bank_base + (pinmask << 2)
# only ever touches that one pin (GPIO7_3 -> mask 0x08 -> offset 0x020),
# so this can't disturb the LED pins living in the same bank. Direction is
# already latched as output by that same boot-time init and never reverts,
# so it doesn't need to be re-asserted here.
reset() {
	echo "Resetting ar8030..."
	stop

	devmem 0x11097020 32 0x00	# assert reset (GPIO7_3 low)
	sleep 1				# vendor pulse is ~3.1ms; wide margin
	devmem 0x11097020 32 0x08	# release reset (GPIO7_3 high)
	sleep 1				# let the chip's ROM bootloader come up before probing

	start
}

case "$1" in
	start)
		start
		;;

	stop)
		stop
		;;

	restart|reload)
		stop
		sleep 1
		start
		;;

	reset)
		reset
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reset}"
		exit 1
		;;
esac
