From: OpenIPC builder
Subject: [PATCH] kmod: link_trailer mode for baseband firmware with SDIO link framing

Some AR8030 baseband firmware (e.g. the BetaFPV P1 air unit's) frames
every SDIO transfer as runs ending in a { flags, type, len } trailer
(0xDD commands, 0xCC IPv4 tunnel, 0xEE flow-control ACKs); without it
the chip never answers an RPC. link_trailer=1 wraps each RPC frame as a
0xDD run and unwraps received runs. Off by default (Caddx firmware has
no trailer). Needs kernel-owned RX, so it implies net_mode.
---
diff --git a/kmod/artosyn_drv.h b/kmod/artosyn_drv.h
index 5367f0e..573c222 100644
--- a/kmod/artosyn_drv.h
+++ b/kmod/artosyn_drv.h
@@ -92,8 +92,17 @@ struct artosyn_dev {
 	void *rx_scratch;              /* SDIO_TRANS_MAX_SZIE, drain target if alloc_skb() fails */
 	atomic_t open_count;
 
+	/* link_trailer=1 only: SDIO_TRANS_MAX_SZIE staging buffer each RPC
+	 * frame is copied into so the { 0x00, type, len } trailer can be
+	 * appended to its last block (see artosyn_write_trailer()). */
+	u8 *tx_stage;
+
 	/* Counters, reported via the netdev's sysfs stats file. */
 	unsigned long irq_events;
+	unsigned long tx_trailer_drops;  /* frame larger than the chip's TX grant */
+	unsigned long rx_trailer_errors; /* transfer without a parseable trailer run */
+	unsigned long rx_trailer_ip;     /* 0xCC IPv4-tunnel runs (not handled, dropped) */
+	unsigned long rx_trailer_ack;    /* 0xEE flow-control runs (ignored) */
 	unsigned long rx_transfers;
 	unsigned long rx_transfer_bytes;
 	unsigned long rx_errors;
diff --git a/kmod/artosyn_sdio.c b/kmod/artosyn_sdio.c
index 1088cf4..b902298 100644
--- a/kmod/artosyn_sdio.c
+++ b/kmod/artosyn_sdio.c
@@ -67,6 +67,39 @@ static char *fw_name;
 static char *cfg_name;
 static bool native_net = true;
 
+/*
+ * Link-frame trailer mode (link_trailer=1). Some baseband firmware builds --
+ * e.g. the one on the BetaFPV P1 (Proxima-9311) air unit -- frame every SDIO
+ * transfer, both directions, as one or more "runs": the payload, zero-padded
+ * so that payload + 4 fills whole 512-byte blocks, with the last 4 bytes of
+ * the run's final block a trailer { flags, type, len_lo, len_hi }, len being
+ * the payload length. flags is 0x00 on everything the host sends and on
+ * 0xDD from the chip; the chip's periodic (~10 Hz) 0xEE ACKs carry 0x01. The type selects the channel: 0xDD bb command/response
+ * (the RPC traffic ar8030d and the netdev exchange), 0xCC an IPv4 tunnel,
+ * 0xEE a flow-control ACK. Without the trailer that firmware never answers
+ * an RPC; the Caddx Ascent firmware uses no trailer at all, hence off by
+ * default. Framing as documented and hardware-validated by MissingLynk's
+ * open driver (ml-kernel docs/artosyn-sdio.md, modules/artosyn_sdio.c).
+ *
+ * Here every RPC frame goes out as one 0xDD run; on RX, 0xDD runs are
+ * unwrapped and handed on exactly like an untrailered transfer, 0xEE runs
+ * are ignored (they only pace the 0xCC data path) and 0xCC runs are dropped
+ * and counted -- this driver's networking uses bb sockets (0xDD), not the
+ * firmware's IPv4 tunnel.
+ */
+static bool link_trailer;
+
+#define LINK_TYPE_IP           0xCC
+#define LINK_TYPE_CMD          0xDD
+#define LINK_TYPE_ACK          0xEE
+#define LINK_TRAILER_LEN       4
+#define LINK_MAX_RUNS          16
+
+/* RPC frame: 0xaa, u32 LE data length, reqid/msgid/sta (3 x u32), xor
+ * byte, data, 0xbb -- 19 bytes plus the data. */
+#define RPC_FRAME_HEAD         0xaa
+#define RPC_FRAME_OVERHEAD     19
+
 /* SDIO function/vendor/device IDs. The chip enumerates as ARTO_ROMCODE_*
  * (its boot-ROM identity) on power-up; after a successful firmware push
  * it re-enumerates as ARTO_RTOS_ALT_* (or, on some units, ARTO_RTOS_*) --
@@ -211,6 +244,87 @@ static void artosyn_cdev_rx_queue(struct artosyn_dev *dev, struct sk_buff *skb)
 	wake_up_interruptible_all(&dev->rx_q);
 }
 
+/* Hand one transfer's worth of RPC bytes on: the netdev's socket frames to
+ * the netdev, the rest to /dev/artosyn_sdio. */
+static void artosyn_rx_deliver(struct artosyn_dev *dev, struct sk_buff *skb)
+{
+	skb = artosyn_net_rx(dev, skb);
+	if (skb)
+		artosyn_cdev_rx_queue(dev, skb);
+}
+
+/*
+ * link_trailer RX: split one transfer into its runs and deliver the 0xDD
+ * payloads. A transfer can hold several runs when the chip queued more
+ * blocks before the earlier ones were drained, so the run boundaries are
+ * recovered by walking the trailers back from the end (each run occupies
+ * ALIGN(payload + 4, 512) bytes). Consumes skb.
+ */
+static void artosyn_rx_trailer_runs(struct artosyn_dev *dev, struct sk_buff *skb)
+{
+	struct {
+		u32 start;
+		u32 payload;
+		u8 type;
+	} runs[LINK_MAX_RUNS];
+	const u8 *buf = skb->data;
+	u32 pos = skb->len;
+	int nruns = 0, i;
+
+	while (pos >= SDIO_DEVICE_BLOCK_SIZE && nruns < LINK_MAX_RUNS) {
+		u8 type = buf[pos - 3];
+		u32 pl = buf[pos - 2] | (buf[pos - 1] << 8);
+		u32 rsize = ALIGN(pl + LINK_TRAILER_LEN, SDIO_DEVICE_BLOCK_SIZE);
+
+		/* Byte 0 is not always 0: the chip's periodic 0xEE ACKs
+		 * carry 0x01 there. Validate on the type instead. */
+		if (rsize > pos ||
+		    (type != LINK_TYPE_CMD && type != LINK_TYPE_IP && type != LINK_TYPE_ACK))
+			break;
+		runs[nruns].start = pos - rsize;
+		runs[nruns].payload = pl;
+		runs[nruns].type = type;
+		nruns++;
+		pos -= rsize;
+	}
+
+	if (pos || !nruns) {
+		dev->rx_trailer_errors++;
+		dev_warn_ratelimited(&dev->func->dev,
+				     "rx: %u-byte transfer without a valid link trailer (head %*ph, tail %*ph), dropped\n",
+				     skb->len, 8, buf, 8, buf + skb->len - 8);
+		kfree_skb(skb);
+		return;
+	}
+
+	/* runs[] was filled back to front; deliver in stream order. */
+	for (i = nruns - 1; i >= 0; i--) {
+		struct sk_buff *run;
+
+		switch (runs[i].type) {
+		case LINK_TYPE_CMD:
+			if (!runs[i].payload)
+				break; /* empty keepalive */
+			run = alloc_skb(runs[i].payload, GFP_KERNEL);
+			if (!run) {
+				dev->rx_errors++;
+				break;
+			}
+			skb_put_data(run, buf + runs[i].start, runs[i].payload);
+			art_dbg(dev, ART_DBG_RX, "rx 0xDD run %u bytes\n", runs[i].payload);
+			artosyn_rx_deliver(dev, run);
+			break;
+		case LINK_TYPE_IP:
+			dev->rx_trailer_ip++;
+			break;
+		default:
+			dev->rx_trailer_ack++;
+			break;
+		}
+	}
+	kfree_skb(skb);
+}
+
 /*
  * net_mode RX: read one whole RX-ready transfer out of the FIFO and demux
  * it (netdev socket frames vs. everything else). Caller holds the host.
@@ -260,9 +374,10 @@ static void artosyn_rx_transfer(struct artosyn_dev *dev, unsigned int size)
 		print_hex_dump(KERN_INFO, "artosyn rx: ", DUMP_PREFIX_OFFSET, 16, 1,
 			       skb->data, min_t(unsigned int, size, 128), false);
 
-	skb = artosyn_net_rx(dev, skb);
-	if (skb)
-		artosyn_cdev_rx_queue(dev, skb);
+	if (link_trailer)
+		artosyn_rx_trailer_runs(dev, skb);
+	else
+		artosyn_rx_deliver(dev, skb);
 }
 
 static bool artosyn_check_events(struct artosyn_dev *dev)
@@ -346,6 +461,59 @@ static bool artosyn_write_condition(struct artosyn_dev *dev)
 	return dev->removed || dev->write_offset < dev->write_valid_size;
 }
 
+/* Length of the RPC frame at the start of buf. Writers (ar8030d's
+ * sdio_write(), the netdev) pad each frame to whole blocks, but the link
+ * trailer has to carry the real length. Anything that isn't an RPC frame
+ * is sent as-is. */
+static size_t artosyn_rpc_len(const u8 *buf, size_t count)
+{
+	size_t len;
+
+	if (count < RPC_FRAME_OVERHEAD || buf[0] != RPC_FRAME_HEAD)
+		return count;
+	len = RPC_FRAME_OVERHEAD + (buf[1] | (buf[2] << 8) | (buf[3] << 16) | ((u32)buf[4] << 24));
+	return len <= count ? len : count;
+}
+
+/*
+ * link_trailer TX: one write() is one RPC frame, sent as one 0xDD run.
+ * Always consumes the whole write -- a frame can't be split across runs.
+ * The TX window is all-or-nothing (a write consumes the whole grant), so a
+ * frame larger than the grant can never fit; drop it like the vendor does
+ * rather than wedge. Caller holds io_mutex and the host.
+ */
+static ssize_t artosyn_write_trailer(struct artosyn_dev *dev, const u8 *buf, size_t count,
+				     unsigned int room)
+{
+	size_t pl = artosyn_rpc_len(buf, count);
+	unsigned int blk = ALIGN(pl + LINK_TRAILER_LEN, SDIO_DEVICE_BLOCK_SIZE);
+	u8 *stage = dev->tx_stage;
+	int ret;
+
+	if (!stage || pl > 0xffff || blk > SDIO_TRANS_MAX_SZIE)
+		return -EMSGSIZE;
+
+	if (blk > room) {
+		dev->tx_trailer_drops++;
+		dev_warn_ratelimited(&dev->func->dev, "tx: %zu-byte frame exceeds the %u-byte TX grant, dropped\n",
+				     pl, room);
+		return count;
+	}
+
+	memcpy(stage, buf, pl);
+	memset(stage + pl, 0, blk - pl);
+	stage[blk - 3] = LINK_TYPE_CMD;
+	stage[blk - 2] = pl & 0xff;
+	stage[blk - 1] = (pl >> 8) & 0xff;
+
+	ret = sdio_memcpy_toio(dev->func, FIFO_ADDRESS, stage, blk);
+	if (ret)
+		return ret;
+	dev->write_offset = dev->write_valid_size;
+	art_dbg(dev, ART_DBG_TX, "tx 0xDD run %zu bytes (%u on the wire)\n", pl, blk);
+	return count;
+}
+
 /*
  * Low-level write: waits (patiently -- see SDIO_WRITE_WAIT_MS's own
  * comment) for room, then hands at most one SDIO_TRANS_MAX_SZIE-sized,
@@ -422,6 +590,14 @@ static ssize_t artosyn_write_chunk(struct artosyn_dev *dev, const void *buf, siz
 	sdio_claim_host(func);
 
 	room = dev->write_valid_size - dev->write_offset;
+
+	if (link_trailer && !dev->rom_mode) {
+		ret = artosyn_write_trailer(dev, buf, count, room);
+		sdio_release_host(func);
+		mutex_unlock(&dev->io_mutex);
+		return ret;
+	}
+
 	if (count > room)
 		count = room;
 	if (count > SDIO_TRANS_MAX_SZIE)
@@ -975,13 +1151,26 @@ static int artosyn_probe(struct sdio_func *func, const struct sdio_device_id *id
 	 * would sit in the FIFO forever once read() stops touching it. Never
 	 * in ROM mode -- the boot ROM speaks no RPC and the firmware push
 	 * doesn't read anything back. */
-	if (native_net && is_rtos_id(func)) {
+	if ((native_net || link_trailer) && is_rtos_id(func)) {
 		dev->rx_scratch = kmalloc(SDIO_TRANS_MAX_SZIE, GFP_KERNEL);
 		if (dev->rx_scratch)
 			dev->net_mode = true;
 		else
 			dev_err(&func->dev, "native_net: no memory for rx scratch, falling back to chardev-only\n");
 	}
+
+	/* link_trailer needs the kernel-owned RX path (runs have to be
+	 * unwrapped before anything reaches read()) and a TX staging buffer. */
+	if (link_trailer && is_rtos_id(func)) {
+		dev->tx_stage = kmalloc(SDIO_TRANS_MAX_SZIE, GFP_KERNEL);
+		if (!dev->tx_stage || !dev->net_mode) {
+			kfree(dev->tx_stage);
+			kfree(dev->rx_scratch);
+			kfree(dev);
+			return -ENOMEM;
+		}
+		dev_info(&func->dev, "link_trailer: SDIO transfers framed as 0xDD runs\n");
+	}
 	sdio_set_drvdata(func, dev);
 
 	sdio_claim_host(func);
@@ -1028,7 +1217,7 @@ static int artosyn_probe(struct sdio_func *func, const struct sdio_device_id *id
 		/* A netdev failure is not a probe failure: /dev/artosyn_sdio
 		 * (and so ar8030d) works either way, net_mode just routes
 		 * every RX transfer to it. */
-		if (dev->net_mode) {
+		if (dev->net_mode && native_net) {
 			ret = artosyn_net_probe(dev);
 			if (ret)
 				dev_err(&func->dev, "native_net: netdev setup failed: %d (chardev still available)\n",
@@ -1063,6 +1252,7 @@ err_disable_func:
 err_release_host:
 	sdio_release_host(func);
 	sdio_set_drvdata(func, NULL);
+	kfree(dev->tx_stage);
 	kfree(dev->rx_scratch);
 	kfree(dev);
 	return ret;
@@ -1104,6 +1294,7 @@ static void artosyn_remove(struct sdio_func *func)
 	if (g_dev == dev)
 		g_dev = NULL;
 	skb_queue_purge(&dev->cdev_rxq);
+	kfree(dev->tx_stage);
 	kfree(dev->rx_scratch);
 	kfree(dev);
 }
@@ -1128,6 +1319,8 @@ module_param_named(debug, artosyn_debug, uint, 0644);
 MODULE_PARM_DESC(debug, "Debug log classes: 0x1 init, 0x2 irq, 0x4 rx, 0x8 tx, 0x10 hexdump (default 0)");
 
 module_param(native_net, bool, 0444);
+MODULE_PARM_DESC(link_trailer, "Frame SDIO transfers with the { 0x00, type, len } link trailer some baseband firmware (e.g. BetaFPV P1) requires (default off)");
+module_param(link_trailer, bool, 0444);
 MODULE_PARM_DESC(native_net, "Register a native net_device on the RTOS chip and demux its socket in the kernel (default 1)");
 
 module_param(fw_name, charp, 0);
