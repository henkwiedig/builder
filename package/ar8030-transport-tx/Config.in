config BR2_PACKAGE_AR8030_TRANSPORT_TX
	bool "ar8030-transport-tx"
	depends on BR2_PACKAGE_AR8030
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_LINUX_KERNEL
	help
	  Air-side bridge between waybeam's frame-shm:// ring and the
	  AR8030's non-IP baseband data channel (bb_socket) -- see
	  https://github.com/henkwiedig/ar8030-transport.

	  Splits each encoded H.265 access unit from waybeam into chunks
	  and writes them to a bb_socket, and throttles waybeam's live
	  bitrate (GET /api/v1/set?video0.bitrate=) from the AR8030's own
	  local TX MCS/throughput reading, so the encoder does not outrun
	  the radio.

	  Also builds and installs this project's own clean-room-rewritten
	  AR8030 SDIO chardev kernel module (kmod/artosyn_drv.c -- see the
	  README's "Clean-room rewrite" section) and this package's own
	  S65 init script loads it, starts ar8030d against it (-i 1, SDIO
	  mode -- the only mode this module implements), and keeps it
	  paired to its ground-side peer, before starting the transport
	  bridge itself. The ar8030 package no longer builds a kernel
	  module at all, so this package is now the sole provider of AR8030
	  kernel-side support.

	  Requires the ar8030 package's own
	  0008-session_socket-preserve-datagram-flag-on-open.patch (see
	  ar8030-transport's README "Required AR8030 SDK fix" -- without
	  it, chunks above ~690 bytes fail). Also expects waybeam to be
	  present and its frame-shm ring enabled, but that is not wired as
	  a hard Buildroot dependency here since waybeam can come from a
	  different image; enable it yourself if this device doesn't
	  already have it.

	  Installs /usr/bin/ar8030-transport-tx, /usr/bin/ar8030-linkctl,
	  artosyn_drv.ko, and /etc/init.d/S65ar8030-transport-tx.

comment "ar8030-transport-tx needs ar8030, a Linux kernel, and a toolchain w/ threads"
	depends on !BR2_PACKAGE_AR8030 || !BR2_LINUX_KERNEL || !BR2_TOOLCHAIN_HAS_THREADS
