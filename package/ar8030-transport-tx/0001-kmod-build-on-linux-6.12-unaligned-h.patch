From: OpenIPC builder
Subject: [PATCH] kmod: build on Linux >= 6.12 (asm/unaligned.h -> linux/unaligned.h)

Linux 6.12 moved <asm/unaligned.h> to <linux/unaligned.h>; needed for the
AR9311 (ar9311_artosyn_artlynk-p1) mainline 6.18 kernel.
---
diff --git a/kmod/artosyn_net.c b/kmod/artosyn_net.c
index 489305b..2f80956 100644
--- a/kmod/artosyn_net.c
+++ b/kmod/artosyn_net.c
@@ -30,7 +30,12 @@
 #include <linux/workqueue.h>
 #include <linux/completion.h>
 #include <linux/string.h>
+#include <linux/version.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+#include <linux/unaligned.h>
+#else
 #include <asm/unaligned.h>
+#endif
 
 #include "artosyn_drv.h"
 
