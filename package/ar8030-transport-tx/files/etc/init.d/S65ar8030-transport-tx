#!/bin/sh
#
# ar8030-transport-tx: loads the AR8030's kernel module (artosyn_drv, this
# repo's own clean-room rewrite of the SDIO chardev -- see kmod/artosyn_drv.c
# and the README's "Clean-room rewrite" section for the full story), starts
# ar8030d against it, hands the chip's whole lifecycle (hardware reset,
# pairing, reconnect-on-drop, link-state tracking) to ar8030-lifecycled, and
# bridges waybeam's frame-shm:// ring to the AR8030's non-IP baseband data
# channel (bb_socket).
#
# This absorbs what used to be the separate ar8030 package's own
# S60ar8030 init script -- that script is gone now that ar8030 no longer
# builds a kernel module at all (see package/ar8030/ar8030.mk's "Userspace
# only" comment), so this is the one script that owns the whole AR8030
# bring-up sequence end to end: module -> daemon -> lifecycle -> transport.
#
# ar8030-lifecycled replaces this script's own former autoreconnect/
# device_watchdog/apply_link_tuning shell logic (see package/ar8030's own
# Config.in BR2_PACKAGE_AR8030_LIFECYCLED help, and dev_helper/
# ar8030-lifecycled/main.c's header comment, for the full story of why a
# dedicated process rather than more shell watchdogs). It does NOT yet do
# tuning persistence (bandwidth/channel surviving a reconnect) or hook-
# script dispatch on state transitions -- deliberately deferred rather than
# rushed. Concretely, that means: the board LED (this device's own
# ar8030-led-status.sh/S67, if present) has nothing left driving it from
# link state, and a bandwidth/channel changed by hand via ar8030-linkctl no
# longer survives a reconnect on its own. Both are known, accepted gaps
# until ar8030-lifecycled grows hook-script dispatch and tuning persistence.
#

# Serializes every invocation of this script (start/stop/restart/reset)
# against each other. Without this, two overlapping invocations (e.g. a
# bind-button press landing while an earlier manual "restart" is still
# finishing) can race: the second one's stop() reads a pidfile after the
# first's start() has already overwritten it with a new PID, so the
# first's still-running background child never gets killed and leaks
# forever (confirmed live -- found via `ps` showing two long-orphaned
# processes, neither referenced by its pidfile anymore).
#
# NOT `exec flock LOCKFILE "$0" "$@"` -- tried that first, and it
# deadlocks this specific script: flock's lock is held by an *open file
# descriptor*, and start()'s own start_tx() forks a long-lived detached
# background child that inherits that descriptor across fork(). That
# child outlives this script's own process by design (that's the whole
# point of backgrounding it), so the lock never actually releases --
# confirmed live: a second invocation hung forever waiting to acquire it,
# killing the video link in the process (had to kill -9 everything and
# manually recover).
#
# A plain PID-file mutex instead: only waits for the *previous top-level
# script process* to exit (which happens right after start() finishes
# launching its background children and their pidfiles are already
# written), never for anything backgrounded. That's the actual race this
# needs to close.
ACTION_LOCKFILE=/var/run/ar8030-transport-tx.action.lock
lock_pid=$(cat "$ACTION_LOCKFILE" 2>/dev/null)
if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
	echo "ar8030-transport-tx: waiting for pid $lock_pid's start/stop/reset to finish..."
	while kill -0 "$lock_pid" 2>/dev/null; do
		sleep 1
	done
fi
echo $$ >"$ACTION_LOCKFILE"
trap 'rm -f "$ACTION_LOCKFILE"' EXIT

test -r /etc/default/ar8030-transport-tx && . /etc/default/ar8030-transport-tx

MODULE="artosyn_drv"
FW_NAME="ar8030/ar8030.img"
CFG_NAME="ar8030/ar8030.json"
# 1 = INTF_TYPE_SDIO (/dev/artosyn_sdio) -- the only interface this
# module implements. INTF_TYPE_DRV (3, /dev/ar_mdev<N>) has no kernel-side
# counterpart left to open at all (see package/ar8030/Config.in).
INTF=1

AR8030D="/usr/bin/ar8030d"
AR8030D_PIDFILE="/var/run/ar8030d.pid"

# Hardware reset line (GPIO7_3) this board wires the AR8030's own reset
# input to -- ar8030-lifecycled pulses this itself at every startup now
# (replacing this script's own former reset() devmem pokes), so a normal
# `start` always begins from a known-good hardware state instead of only
# a manual `reset` action forcing one.
LIFECYCLED="/usr/bin/ar8030-lifecycled"
LIFECYCLED_PIDFILE="/var/run/ar8030-lifecycled.pid"
LIFECYCLED_RESET_DEVMEM_ADDR="0x11097020"

DAEMON="/usr/bin/ar8030-transport-tx"
RUNDIR="/tmp/ar8030"
PIDFILE="$RUNDIR/ar8030-transport-tx.pid"
LOGFILE="$RUNDIR/ar8030-transport-tx.log"
WATCHDOG_PIDFILE="$RUNDIR/ar8030-transport-tx-watchdog.pid"

if [ "x$AR8030_TRANSPORT_TX_ENABLED" = "xfalse" ]; then
	echo "Starting ar8030-transport-tx... skipped (disabled)"
	exit 0
fi

# request_firmware() (kmod/artosyn_drv.c's artosyn_download_firmware(),
# module params fw_name=/cfg_name=) resolves relative to this sysfs path,
# not a compiled-in default -- has to be set before modprobe.
load_module() {
	echo -n "/lib/firmware" > /sys/module/firmware_class/parameters/path
	args=""
	[ -f "/lib/firmware/$FW_NAME" ] && args="$args fw_name=$FW_NAME"
	[ -f "/lib/firmware/$CFG_NAME" ] && args="$args cfg_name=$CFG_NAME"
	modprobe "$MODULE" $args || return 1
	# Settle time for the boot-ROM firmware push + the chip's
	# re-enumeration from its ROMCODE identity (4152:8030) to its RTOS
	# identity (4152:8031) to finish before ar8030d tries to open
	# /dev/artosyn_sdio.
	sleep 3
}

start_daemon() {
	mkdir -p "$RUNDIR"
	cd "$RUNDIR" || return 1
	start-stop-daemon -S -q -b -m -p "$AR8030D_PIDFILE" -x "$AR8030D" -- -i $INTF
}

start_lifecycled() {
	[ -x "$LIFECYCLED" ] || return 0
	mkdir -p "$RUNDIR"
	cd "$RUNDIR" || return 1
	start-stop-daemon -S -q -b -m -p "$LIFECYCLED_PIDFILE" -x "$LIFECYCLED" -- \
		--role ap \
		--reset-method devmem --reset-devmem-addr "$LIFECYCLED_RESET_DEVMEM_ADDR" \
		--hook-dir /etc/ar8030/hooks.d \
		--cfg-path "/lib/firmware/$CFG_NAME" \
		--default-bandwidth 20
}

# Confirmed on real hardware (SDIO daemon mode bring-up, see
# ar8030-transport's own README "SDIO chardev" section): a stuck RPC
# reply somewhere in the SDK client library (libar8030_client.so) can
# wedge one of this process's own threads forever, blocked waiting on a
# reply that never arrives -- while ar8030d itself and a *completely
# separate, freshly-started* client both stay perfectly healthy at the
# same time. The process doesn't crash and doesn't spin (0% CPU), so
# nothing external can distinguish "genuinely idle, nothing to send
# right now" from "permanently wedged" except this process's own
# forward progress -- and a thread stuck this way can't be gracefully
# unstuck from outside, so recovery needs a full process restart, not a
# soft reconnect.
#
# -v's own stats line (tx/main.c, STATS_INTERVAL_S=1.0) becomes the
# heartbeat: it only gets printed by the main loop actually still
# iterating, so its log file's mtime staleness is a reliable "has this
# process made forward progress recently" signal regardless of which
# internal call is stuck. WATCHDOG_STALE_S gives a wide margin over the
# expected ~1s cadence to avoid false triggers from e.g. a slow frame-shm
# ring wait.
WATCHDOG_STALE_S=6

start_tx() {
	mkdir -p "$RUNDIR"
	(
		exec "$DAEMON" -v $AR8030_TRANSPORT_TX_ARGS
	) >>"$LOGFILE" 2>&1 &
	echo $! > "$PIDFILE"
}

watchdog() {
	# Checks actual byte-progress from -v's own "totals: ... bytes=N"
	# field, not just log mtime: confirmed on real hardware that a
	# different failure mode also happens where the main loop keeps
	# iterating and printing fresh stats lines every second (so an
	# mtime-only check never notices anything wrong) while
	# bb_socket_write() fails fast and repeatedly, "bytes=" frozen at
	# the same value indefinitely -- a real stall from the user's
	# perspective (no video) that isn't a frozen process. Two
	# consecutive unchanged readings (2x WATCHDOG_STALE_S) before
	# restarting, to tolerate a transient backlog spike that clears on
	# its own within one check interval. A fully wedged process (no new
	# log lines at all) also shows unchanged "bytes=" here, so this one
	# check covers both failure modes -- the earlier mtime-only version
	# only caught the frozen-process case.
	last_bytes=""
	stall_count=0
	while true; do
		sleep "$WATCHDOG_STALE_S"
		pid=$(cat "$PIDFILE" 2>/dev/null)
		if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
			last_bytes=""
			stall_count=0
			continue
		fi

		bytes=$(tail -n 20 "$LOGFILE" 2>/dev/null | grep -o 'bytes=[0-9]*' | tail -1 | cut -d= -f2)
		if [ -n "$bytes" ] && [ "$bytes" = "$last_bytes" ]; then
			stall_count=$((stall_count + 1))
		else
			stall_count=0
		fi
		last_bytes="$bytes"

		if [ "$stall_count" -ge 2 ]; then
			echo "$(date): no byte progress for $((stall_count * WATCHDOG_STALE_S))s (stuck at bytes=$bytes), restarting" >>"$LOGFILE"
			kill -9 "$pid" 2>/dev/null
			start_tx
			last_bytes=""
			stall_count=0
		fi
	done
}

start() {
	echo "Starting ar8030-transport-tx..."
	mkdir -p "$RUNDIR"
	load_module || echo "artosyn_drv: modprobe failed, continuing without it"
	start_daemon
	start_lifecycled
	: > "$LOGFILE"
	start_tx
	watchdog &
	echo $! > "$WATCHDOG_PIDFILE"
}

stop() {
	echo "Stopping ar8030-transport-tx..."
	[ -f "$WATCHDOG_PIDFILE" ] && kill "$(cat "$WATCHDOG_PIDFILE")" 2>/dev/null
	rm -f "$WATCHDOG_PIDFILE"
	[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
	[ -f "$LIFECYCLED_PIDFILE" ] && kill "$(cat "$LIFECYCLED_PIDFILE")" 2>/dev/null
	rm -f "$LIFECYCLED_PIDFILE"
	[ -f "$AR8030D_PIDFILE" ] && kill "$(cat "$AR8030D_PIDFILE")" 2>/dev/null
	rm -f "$AR8030D_PIDFILE"
	rmmod "$MODULE" 2>/dev/null
}

# Recovers a card left in a bad state (e.g. a stale socket held by a
# killed daemon) without a full board power-cycle. Used to also pulse the
# AR8030's hardware reset line here directly (devmem pokes) before
# start() -- that now happens inside ar8030-lifecycled's own startup
# instead (see start_lifecycled() above), so a plain stop-then-start
# already gets a fresh hardware reset every time.
reset() {
	stop
	start
}

case "$1" in
	start)
		start
		;;

	stop)
		stop
		;;

	restart|reload)
		stop
		sleep 1
		start
		;;

	reset)
		reset
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reset}"
		exit 1
		;;
esac
