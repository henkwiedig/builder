#!/bin/sh
#
# ar8030-transport-tx: loads the AR8030's kernel module (artosyn_drv, this
# repo's own clean-room rewrite of the SDIO chardev -- see kmod/artosyn_drv.c
# and the README's "Clean-room rewrite" section for the full story), starts
# ar8030d against it, hands the chip's whole lifecycle (hardware reset,
# pairing, reconnect-on-drop, link-state tracking, and -- if
# AR8030_LIFECYCLED_ARGS below passes --bind-gpio -- the physical bind
# button too) to ar8030-lifecycled, and bridges waybeam's frame-shm://
# ring to the AR8030's non-IP baseband data channel (bb_socket).
#
# This absorbs what used to be the separate ar8030 package's own
# S60ar8030 init script -- that script is gone now that ar8030 no longer
# builds a kernel module at all (see package/ar8030/ar8030.mk's "Userspace
# only" comment), so this is the one script that owns the whole AR8030
# bring-up sequence end to end: module -> daemon -> lifecycle -> transport.
#
# ar8030-lifecycled (ar8030-transport/lifecycled/, built by this
# package -- see AR8030_TRANSPORT_TX_BUILD_CMDS in its own .mk, and that
# repo's README "ar8030-lifecycled: link supervisor + bind button")
# replaces this script's own former autoreconnect/device_watchdog/
# apply_link_tuning shell logic, and (since it moved into this daemon)
# a board's own separate bind-button poller script too.
#
# start() no longer starts the tx binary itself -- that is now fully
# hook-driven (see the "tx-start"/"tx-stop" actions below), matching the
# board LED (hooks.d/*/10-led.sh) and the AR8030 TUN bridge's own
# ifup/ifdown (hooks.d/*/30-ifup.sh, .../30-ifdown.sh): ar8030-lifecycled
# calls "tx-start" on reaching a real CONNECT and "tx-stop" on a real
# drop, so no video process runs at all while there is no link to carry
# it. Deliberate tradeoff, chosen over leaving tx running through drops
# (which it already tolerates internally, waiting for the next CONNECT
# on its own): full symmetry with ifup/ifdown at the cost of restarting
# the video process on every drop/reconnect cycle, including during a
# flapping link. A board with no working ar8030-lifecycled (binary
# missing, or a board that opts out) gets no video at all as a result --
# accepted, since ar8030-lifecycled owning tx's lifecycle end to end is
# the whole point of this cutover.
#

# Serializes every invocation of this script (start/stop/restart/reset)
# against each other. Without this, two overlapping invocations (e.g. a
# bind-button press landing while an earlier manual "restart" is still
# finishing) can race: the second one's stop() reads a pidfile after the
# first's start() has already overwritten it with a new PID, so the
# first's still-running background child never gets killed and leaks
# forever (confirmed live -- found via `ps` showing two long-orphaned
# processes, neither referenced by its pidfile anymore).
#
# NOT `exec flock LOCKFILE "$0" "$@"` -- tried that first, and it
# deadlocks this specific script: flock's lock is held by an *open file
# descriptor*, and start()'s own start_tx() forks a long-lived detached
# background child that inherits that descriptor across fork(). That
# child outlives this script's own process by design (that's the whole
# point of backgrounding it), so the lock never actually releases --
# confirmed live: a second invocation hung forever waiting to acquire it,
# killing the video link in the process (had to kill -9 everything and
# manually recover).
#
# A plain PID-file mutex instead: only waits for the *previous top-level
# script process* to exit (which happens right after start() finishes
# launching its background children and their pidfiles are already
# written), never for anything backgrounded. That's the actual race this
# needs to close.
ACTION_LOCKFILE=/var/run/ar8030-transport-tx.action.lock
lock_pid=$(cat "$ACTION_LOCKFILE" 2>/dev/null)
if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
	echo "ar8030-transport-tx: waiting for pid $lock_pid's start/stop/reset to finish..."
	while kill -0 "$lock_pid" 2>/dev/null; do
		sleep 1
	done
fi
echo $$ >"$ACTION_LOCKFILE"
trap 'rm -f "$ACTION_LOCKFILE"' EXIT

test -r /etc/default/ar8030-transport-tx && . /etc/default/ar8030-transport-tx

MODULE="artosyn_drv"
FW_NAME="ar8030/ar8030.img"
CFG_NAME="ar8030/ar8030.json"
# 1 = INTF_TYPE_SDIO (/dev/artosyn_sdio) -- the only interface this
# module implements. INTF_TYPE_DRV (3, /dev/ar_mdev<N>) has no kernel-side
# counterpart left to open at all (see package/ar8030/Config.in).
INTF=1

AR8030D="/usr/bin/ar8030d"
AR8030D_PIDFILE="/var/run/ar8030d.pid"

# ar8030-lifecycled itself does NOT pulse the hardware reset line here --
# see start_lifecycled()'s own comment for why that was tried and reverted
# (fatal race against load_module()'s own modprobe-time firmware push).
# load_module() pulses it instead, right *before* modprobe, so the push
# always starts from a freshly reset chip; the `reset` action (stop() +
# start()) therefore forces a full chip reset + rmmod/modprobe cycle.
LIFECYCLED="/usr/bin/ar8030-lifecycled"
LIFECYCLED_PIDFILE="/var/run/ar8030-lifecycled.pid"

DAEMON="/usr/bin/ar8030-transport-tx"
RUNDIR="/tmp/ar8030"
PIDFILE="$RUNDIR/ar8030-transport-tx.pid"
LOGFILE="$RUNDIR/ar8030-transport-tx.log"
WATCHDOG_PIDFILE="$RUNDIR/ar8030-transport-tx-watchdog.pid"

if [ "x$AR8030_TRANSPORT_TX_ENABLED" = "xfalse" ]; then
	echo "Starting ar8030-transport-tx... skipped (disabled)"
	exit 0
fi

# request_firmware() (kmod/artosyn_drv.c's artosyn_download_firmware(),
# module params fw_name=/cfg_name=) resolves relative to this sysfs path,
# not a compiled-in default -- has to be set before modprobe.
# Pulses the AR8030 reset line (AR8030_RESET_GPIO_BANK/_BIT, see
# /etc/default/ar8030-transport-tx; no-op when unset): low ~3ms, then
# high. Raw register writes on a PL061-style HiSilicon GPIO bank -- the
# data register is address-masked (bank + (1 << bit) * 4 touches only that
# line), direction is bank + 0x400. Same writes the vendor's sys_config.ko
# made, which is where this reset used to live (see hisilicon-opensdk's
# 0001-caddx-ascent-lite.patch for why it moved here).
reset_chip() {
	[ -n "$AR8030_RESET_GPIO_BANK" ] && [ -n "$AR8030_RESET_GPIO_BIT" ] || return 0
	mask=$((1 << AR8030_RESET_GPIO_BIT))
	data=$(printf 0x%x $((AR8030_RESET_GPIO_BANK + (mask << 2))))
	dir=$(printf 0x%x $((AR8030_RESET_GPIO_BANK + 0x400)))
	devmem "$dir" 32 $(($(devmem "$dir" 32) | mask))
	devmem "$data" 32 0
	usleep 3000 2>/dev/null || sleep 0.01
	devmem "$data" 32 "$mask"
}

load_module() {
	reset_chip
	echo -n "/lib/firmware" > /sys/module/firmware_class/parameters/path
	args=""
	[ -f "/lib/firmware/$FW_NAME" ] && args="$args fw_name=$FW_NAME"
	[ -f "/lib/firmware/$CFG_NAME" ] && args="$args cfg_name=$CFG_NAME"
	modprobe "$MODULE" $args || return 1
}

# ar8030d must not open /dev/artosyn_sdio until the chip runs its RTOS
# firmware. The node alone is no signal: artosyn_drv registers it in ROM
# mode too, before its firmware push, and when the chip then re-enumerates
# under an ar8030d that already opened it, ar8030d gets EIO ("sdio rd:
# pollerr!!" / "sdio detach" in its log), never re-attaches, and the link
# never comes up. rtos_ready() checks for an RTOS SDIO identity (4152:8031
# or 1d6b:8030, i.e. anything but the ROMCODE 4152:8030) instead.
#
# The wait runs in the background (see start()) so it never holds up rcS.
# That used to be essential: on the caddx-ascent-lite the AR8030 reset was
# pulsed by open_sys_config (loaded by S95waybeam), so the chip only showed
# up on SDIO after S95 ran -- a blocking wait here stalled S95 and never
# finished, while the old fixed "sleep 3" started ar8030d long before the
# chip existed, leaving it to race the firmware push. reset_chip() owns
# that reset now, but a board without AR8030_RESET_GPIO_* still depends on
# whatever else releases the chip.
RTOS_WAIT_S=120

rtos_ready() {
	[ -c /dev/artosyn_sdio ] || return 1
	for d in /sys/bus/sdio/drivers/$MODULE/*:*; do
		[ -e "$d/vendor" ] || continue
		[ "$(cat "$d/vendor"):$(cat "$d/device")" = "0x4152:0x8030" ] && continue
		return 0
	done
	return 1
}

wait_rtos() {
	i=0
	while ! rtos_ready; do
		if [ $i -ge $((RTOS_WAIT_S * 5)) ]; then
			logger -t ar8030-transport-tx "chip not running RTOS firmware after ${RTOS_WAIT_S}s, starting ar8030d anyway"
			return 0
		fi
		sleep 0.2
		i=$((i + 1))
	done
	# The RTOS probe registers the node before it finishes (netdev setup
	# follows) -- let it complete.
	sleep 0.5
	logger -t ar8030-transport-tx "chip running RTOS firmware after ~$((i / 5))s, starting ar8030d"
}

start_daemon() {
	mkdir -p "$RUNDIR"
	cd "$RUNDIR" || return 1
	start-stop-daemon -S -q -b -m -p "$AR8030D_PIDFILE" -x "$AR8030D" -- -i $INTF
}

start_lifecycled() {
	[ -x "$LIFECYCLED" ] || return 0
	mkdir -p "$RUNDIR"
	cd "$RUNDIR" || return 1
	# --reset-method none, NOT devmem: confirmed live (full-restart testing
	# while moving ar8030-lifecycled into ar8030-transport/lifecycled/)
	# that lifecycled's own hardware-reset pulse, called synchronously at
	# its own startup, is fatal (kills the process outright, no crash log
	# -- consistent with a SIGBUS from a bus fault, print-fatal-signals is
	# 0 on this board) when it races load_module()'s own modprobe-time
	# firmware push a few seconds earlier in this exact same start()
	# sequence -- reproduced repeatedly, process dies 2-3s in every time
	# (matching lc_gpio_reset_devmem()'s own two sleep(1) calls exactly),
	# and survives indefinitely with the identical fresh-reload timing
	# once --reset-method is none instead. start_lifecycled() is only
	# ever called from start(), always right after load_module() already
	# ran moments earlier -- whose own modprobe already resets/
	# initializes the chip (see dmesg's "upgrade spl success"/"upgrade
	# bb_cfg success"/"exit_usb_boot_in_bl1 bb_cfg success"), so
	# lifecycled's own pulse here was always redundant on top of that,
	# not just newly dangerous. This logic in lifecycle_gpio.c is
	# unchanged from before this move (byte-for-byte, same reset-devmem
	# poke) -- a pre-existing bug nobody had hit because nobody had
	# exercised a live S65 restart with this reset backend before.
	start-stop-daemon -S -q -b -m -p "$LIFECYCLED_PIDFILE" -x "$LIFECYCLED" -- \
		--role ap \
		--reset-method none \
		--hook-dir /etc/ar8030/hooks.d \
		--cfg-path "/lib/firmware/$CFG_NAME" \
		--default-bandwidth 20 \
		$AR8030_LIFECYCLED_ARGS
}

# Confirmed on real hardware (SDIO daemon mode bring-up, see
# ar8030-transport's own README "SDIO chardev" section): a stuck RPC
# reply somewhere in the SDK client library (libar8030_client.so) can
# wedge one of this process's own threads forever, blocked waiting on a
# reply that never arrives -- while ar8030d itself and a *completely
# separate, freshly-started* client both stay perfectly healthy at the
# same time. The process doesn't crash and doesn't spin (0% CPU), so
# nothing external can distinguish "genuinely idle, nothing to send
# right now" from "permanently wedged" except this process's own
# forward progress -- and a thread stuck this way can't be gracefully
# unstuck from outside, so recovery needs a full process restart, not a
# soft reconnect.
#
# -v's own stats line (tx/main.c, STATS_INTERVAL_S=1.0) becomes the
# heartbeat: it only gets printed by the main loop actually still
# iterating, so its log file's mtime staleness is a reliable "has this
# process made forward progress recently" signal regardless of which
# internal call is stuck. WATCHDOG_STALE_S gives a wide margin over the
# expected ~1s cadence to avoid false triggers from e.g. a slow frame-shm
# ring wait.
WATCHDOG_STALE_S=6

start_tx() {
	mkdir -p "$RUNDIR"
	(
		exec "$DAEMON" -v $AR8030_TRANSPORT_TX_ARGS
	) >>"$LOGFILE" 2>&1 &
	echo $! > "$PIDFILE"
}

watchdog() {
	# Checks actual byte-progress from -v's own "totals: ... bytes=N"
	# field, not just log mtime: confirmed on real hardware that a
	# different failure mode also happens where the main loop keeps
	# iterating and printing fresh stats lines every second (so an
	# mtime-only check never notices anything wrong) while
	# bb_socket_write() fails fast and repeatedly, "bytes=" frozen at
	# the same value indefinitely -- a real stall from the user's
	# perspective (no video) that isn't a frozen process. Two
	# consecutive unchanged readings (2x WATCHDOG_STALE_S) before
	# restarting, to tolerate a transient backlog spike that clears on
	# its own within one check interval. A fully wedged process (no new
	# log lines at all) also shows unchanged "bytes=" here, so this one
	# check covers both failure modes -- the earlier mtime-only version
	# only caught the frozen-process case.
	last_bytes=""
	stall_count=0
	while true; do
		sleep "$WATCHDOG_STALE_S"
		pid=$(cat "$PIDFILE" 2>/dev/null)
		if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
			last_bytes=""
			stall_count=0
			continue
		fi

		bytes=$(tail -n 20 "$LOGFILE" 2>/dev/null | grep -o 'bytes=[0-9]*' | tail -1 | cut -d= -f2)
		if [ -n "$bytes" ] && [ "$bytes" = "$last_bytes" ]; then
			stall_count=$((stall_count + 1))
		else
			stall_count=0
		fi
		last_bytes="$bytes"

		if [ "$stall_count" -ge 2 ]; then
			echo "$(date): no byte progress for $((stall_count * WATCHDOG_STALE_S))s (stuck at bytes=$bytes), restarting" >>"$LOGFILE"
			kill -9 "$pid" 2>/dev/null
			start_tx
			last_bytes=""
			stall_count=0
		fi
	done
}

tx_running() {
	pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# Idempotent -- ar8030-lifecycled's own hooks.d/connected/20-tx.sh calls
# this on every CONNECT, including a warm restart that observes a link
# already up, so this must be safe to call when tx is already running.
tx_start_action() {
	if tx_running; then
		echo "ar8030-transport-tx already running"
		return 0
	fi
	echo "Starting ar8030-transport-tx (tx)..."
	mkdir -p "$RUNDIR"
	: > "$LOGFILE"
	start_tx
	watchdog &
	echo $! > "$WATCHDOG_PIDFILE"
}

tx_stop_action() {
	echo "Stopping ar8030-transport-tx (tx)..."
	[ -f "$WATCHDOG_PIDFILE" ] && kill "$(cat "$WATCHDOG_PIDFILE")" 2>/dev/null
	rm -f "$WATCHDOG_PIDFILE"
	[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
}

start() {
	echo "Starting ar8030-transport-tx..."
	mkdir -p "$RUNDIR"
	load_module || echo "artosyn_drv: modprobe failed, continuing without it"
	# Backgrounded so rcS never waits on the chip -- see wait_rtos().
	(
		wait_rtos
		start_daemon
		start_lifecycled
	) </dev/null >/dev/null 2>&1 &
}

stop() {
	echo "Stopping ar8030-transport-tx..."
	tx_stop_action
	[ -f "$LIFECYCLED_PIDFILE" ] && kill "$(cat "$LIFECYCLED_PIDFILE")" 2>/dev/null
	rm -f "$LIFECYCLED_PIDFILE"
	[ -f "$AR8030D_PIDFILE" ] && kill "$(cat "$AR8030D_PIDFILE")" 2>/dev/null
	rm -f "$AR8030D_PIDFILE"
	rmmod "$MODULE" 2>/dev/null
}

# Recovers a card left in a bad state (e.g. a stale socket held by a
# killed daemon) without a full board power-cycle. A plain stop-then-
# start already gets a fresh hardware reset every time via start()'s own
# load_module() (modprobe re-pushes firmware+config) -- see
# start_lifecycled()'s own comment for why ar8030-lifecycled itself does
# not also pulse a reset here.
reset() {
	stop
	start
}

case "$1" in
	start)
		start
		;;

	stop)
		stop
		;;

	restart|reload)
		stop
		sleep 1
		start
		;;

	reset)
		reset
		;;

	tx-start)
		tx_start_action
		;;

	tx-stop)
		tx_stop_action
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reset|tx-start|tx-stop}"
		exit 1
		;;
esac
